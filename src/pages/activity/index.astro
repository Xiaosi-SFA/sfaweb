---
import BaseLayout from '@layouts/BaseLayout.astro'
import ActivityCard from '@components/ActivityCard.astro'
import { getCollection } from 'astro:content'
import '@styles/timeline.css'

const activities = (await (getCollection as any)('activity'))
  .filter((e: any) => e.slug.includes('/'))
  .sort((a: any, b: any) => {
  const ad = a.data.date?.valueOf() ?? 0
  const bd = b.data.date?.valueOf() ?? 0
  return bd - ad
})

type TimelineItem = { type: 'activity'; entry: any; side: 'left' | 'right' }
type TimelineYear = { type: 'year'; year: number; side: 'left' | 'right' }
const timeline: Array<TimelineItem | TimelineYear> = []

const groups: Array<{ year: number; items: any[] }> = []
for (const e of activities) {
  const y = new Date(e.data.date).getFullYear()
  const last = groups[groups.length - 1]
  if (!last || last.year !== y) {
    groups.push({ year: y, items: [e] })
  } else {
    last.items.push(e)
  }
}

let startSide: 'left' | 'right' = 'left'
for (const g of groups) {
  timeline.push({ type: 'year', year: g.year, side: startSide })
  g.items.forEach((entry, i) => {
    const side = startSide === 'left' ? (i % 2 === 0 ? 'left' : 'right') : (i % 2 === 0 ? 'right' : 'left')
    timeline.push({ type: 'activity', entry, side })
  })
  startSide = startSide === 'left' ? 'right' : 'left'
}


---
<BaseLayout title="活动" description="活动与重要事件时间轴" disableWaveBg={true}>
  <div class="relative timeline">
    <!-- 中央竖线 -->
    <div class="center-line"></div>

  <div class="stack">
      {timeline.map((item) => (
        item.type === 'year' ? (
          <div class={`year-row`} data-side={item.side}>
            <div class="year-pill">{item.year}</div>
          </div>
        ) : (
          <div class={`timeline-item ${item.side === 'left' ? 'is-left' : 'is-right'}`} data-side={item.side}>
            <div class="timeline-dot"></div>

            {item.side === 'left' ? (
              <>
                <div class="md:pr-10 flex justify-end">
                  <div class="timeline-card">
                    <a href={`/activity/${item.entry.slug}/`} class="block">
                      <ActivityCard title={item.entry.data.title}
                        date={item.entry.data.date}
                        cover={item.entry.data.cover}
                        summary={item.entry.data.summary}
                        tags={item.entry.data.tags}
                      />
                    </a>
                  </div>
                </div>
                <div></div>
              </>
            ) : (
              <>
                <div></div>
                <div class="md:pl-10 flex justify-start">
                  <div class="timeline-card">
                    <a href={`/activity/${item.entry.slug}/`} class="block">
                      <ActivityCard title={item.entry.data.title}
                        date={item.entry.data.date}
                        cover={item.entry.data.cover}
                        summary={item.entry.data.summary}
                        tags={item.entry.data.tags}
                      />
                    </a>
                  </div>
                </div>
              </>
            )}
          </div>
        )
      ))}
    </div>
  </div>

  <script is:inline>
    const items = Array.from(document.querySelectorAll('.timeline-item'))

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible')
          io.unobserve(entry.target)
        }
      }
    }, { threshold: 0.2 })
    items.forEach((el) => io.observe(el))

    const mq = window.matchMedia('(min-width: 768px)')

    function adjustStacking() {
      items.forEach((item) => item.style.removeProperty('--stack-gap'))
      if (!mq.matches) {
        return
      }

      for (const item of items) {
        const prevSibling = item.previousElementSibling
        if (!prevSibling || !prevSibling.classList.contains('timeline-item')) {
          continue
        }

        const prevCard = prevSibling.querySelector('.timeline-card')
        const prevCover = prevCard?.querySelector('[data-card-cover]')
        if (!prevCard || !prevCover) {
          continue
        }

        const prevCoverRect = prevCover.getBoundingClientRect()
        const itemRect = item.getBoundingClientRect()
        const currentMargin = parseFloat(getComputedStyle(item).marginTop) || 0
        const shift = itemRect.top - prevCoverRect.bottom
        const newMargin = Math.max(currentMargin - shift, 0)
        item.style.setProperty('--stack-gap', `${newMargin}px`)
      }
    }

    const scheduleAdjust = () => requestAnimationFrame(adjustStacking)
    window.addEventListener('load', scheduleAdjust)
    window.addEventListener('resize', scheduleAdjust)
    mq.addEventListener('change', scheduleAdjust)

    scheduleAdjust()
  </script>
</BaseLayout>
