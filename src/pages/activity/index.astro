---
import BaseLayout from '@layouts/BaseLayout.astro'
import ActivityCard from '@components/ActivityCard.astro'
import { getCollection } from 'astro:content'
import '@styles/card.css'

const activities = (await (getCollection as any)('activity'))
  .filter((e: any) => e.slug.includes('/'))
  .sort((a: any, b: any) => {
    const ad = a.data.date?.valueOf() ?? 0
    const bd = b.data.date?.valueOf() ?? 0
    return bd - ad
  })
---
<BaseLayout title="活动">
  <div class="max-w-6xl mx-auto py-6">
    <div class="mb-8 pb-3 border-b border-black/[0.06] dark:border-white/[0.08]">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">活动</h1>
    </div>

    {activities.length ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {activities.map((e: any) => (
          <ActivityCard
            href={`/activity/${e.slug}/`}
            title={e.data.title}
            date={e.data.date}
            cover={e.data.cover}
            summary={e.data.summary}
            tags={e.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="text-slate-500 text-sm">尚无活动记录。</p>
    )}
  </div>
</BaseLayout>
