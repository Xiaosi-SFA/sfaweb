---
import BaseLayout from '@layouts/BaseLayout.astro'
import '@styles/tag.css'
import { getCollection } from 'astro:content'
import TOC from '@components/TOC.astro'
import RelatedActivity from '@components/RelatedActivity.astro'
import BackToTopOrb from '@components/BackToTopOrb.astro'
import NotFound from '@components/NotFound.astro'
import MarkdownContent from '@components/MarkdownContent.astro'

const { slug } = Astro.params as { slug: string }
const entry = (await (getCollection as any)('activity')).find((e: any) => e.slug === slug)
let Content, headings: Array<{ depth: number; text: string; slug: string }> = []

if (entry) {
  const rendered = await entry.render()
  ;({ Content, headings } = rendered)
} else {
  Astro.response.status = 404
}
const paraIndent = Number(entry?.data?.int ?? entry?.data?.indent ?? 0) || 0
---
{entry ? (
  <BaseLayout title={`${entry.data.title} - 活动 - SFA`} disableWaveBg={true}>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="order-2 md:order-1 md:col-span-1">
        <div class="space-y-4 md:sticky md:top-24 md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:pr-1">
          <TOC headings={headings} />
          <RelatedActivity currentSlug={entry.slug} tags={entry.data.tags} />
        </div>
      </div>
      <article class="order-1 md:order-2 md:col-span-2 max-w-none">
        {entry.data.cover ? (
          <img src={entry.data.cover} alt={entry.data.title} class="w-full aspect-[16/9] object-cover rounded-md mb-4" />
        ) : null}
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">{entry.data.title}</h1>
  <div class="mt-2 flex items-center justify-between text-sm text-slate-500 dark:text-slate-400">
          <div>
            {new Date(entry.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
          </div>
          <div class="hidden sm:flex tag-list flex-nowrap max-w-full overflow-hidden">
            {entry.data.tags?.slice(0, 4).map((t: string) => (
              <a href={`/tags/${encodeURIComponent(t)}/`} class="tag tag--article hash whitespace-nowrap">#{t}</a>
            ))}
          </div>
        </div>
        <MarkdownContent Content={Content} indent={paraIndent} />
      </article>
    </div>
    <BackToTopOrb />
  </BaseLayout>
) : (
  <NotFound />
)}
