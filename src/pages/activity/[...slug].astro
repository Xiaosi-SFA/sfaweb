---
import BaseLayout from '@layouts/BaseLayout.astro'
import '@styles/tag.css'
import { getCollection } from 'astro:content'
import TOC from '@components/TOC.astro'
import RelatedActivity from '@components/RelatedActivity.astro'
import BackToTopOrb from '@components/BackToTopOrb.astro'
import MarkdownContent from '@components/MarkdownContent.astro'
import { withBase } from '@utils/path'

export async function getStaticPaths() {
  const activities = (await (getCollection as any)('activity')).filter((e: any) => e.slug.includes('/'))
  return activities.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props as { entry: any }
const { Content, headings } = await entry.render()
const paraIndent = Number(entry?.data?.int ?? entry?.data?.indent ?? 0) || 0
---
<BaseLayout title={`${entry.data.title} - 活动 - SFA`}>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start md:items-stretch">
    <!-- 侧栏：网格行全高度拉伸 (md:self-stretch)，内部吸顶固定 (md:sticky md:top-24) -->
    <div class="order-2 md:order-1 md:col-span-1 md:self-stretch">
      <div class="space-y-4 md:sticky md:top-24 md:max-h-[calc(100vh-6.5rem)] md:overflow-y-auto">
        {headings && headings.length > 0 ? (
          <div class="hidden md:block">
            <TOC headings={headings} />
          </div>
        ) : null}
        <RelatedActivity currentSlug={entry.slug} tags={entry.data.tags} />
      </div>
    </div>
    <!-- 活动正文主体：与侧边栏格式与滚动完全对齐的卡片格式 -->
    <article class="order-1 md:order-2 md:col-span-2 max-w-none p-6 sm:p-8 md:p-10 rounded-2xl bg-white/80 dark:bg-[#2c2c2e]/70 backdrop-blur supports-[backdrop-filter]:bg-white/60 supports-[backdrop-filter]:dark:bg-[#2c2c2e]/60 border border-black/[0.06] dark:border-[#2c2c2e] shadow-xs">
      {entry.data.cover ? (
        <img src={withBase(entry.data.cover)} alt={entry.data.title} class="w-full aspect-[16/9] object-cover rounded-2xl mb-6 shadow-sm border border-slate-200/60 dark:border-white/10" />
      ) : null}
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight text-slate-900 dark:text-slate-100">{entry.data.title}</h1>
      <div class="mt-3 pb-6 border-b border-black/[0.06] dark:border-white/[0.08] flex items-center justify-between text-sm text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-2">
          <time datetime={entry.data.date?.toISOString()}>
            {new Date(entry.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
          {entry.data.author ? <span>· {entry.data.author}</span> : ''}
          {entry.data.location ? <span>· {entry.data.location}</span> : ''}
        </div>
        <div class="hidden sm:flex tag-list flex-nowrap max-w-full overflow-hidden">
          {entry.data.tags?.slice(0, 4).map((t: string) => (
            <a href={withBase(`/tags/${encodeURIComponent(t)}/`)} class="tag tag--article hash whitespace-nowrap">#{t}</a>
          ))}
        </div>
      </div>
      <div class="pt-6">
        <MarkdownContent Content={Content} indent={paraIndent} align={entry.data?.align} />
      </div>
    </article>
  </div>
  <BackToTopOrb />
</BaseLayout>
