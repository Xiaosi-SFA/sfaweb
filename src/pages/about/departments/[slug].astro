---
import BaseLayout from '@layouts/BaseLayout.astro'
import NotFound from '@components/NotFound.astro'
import MemberCard from '@components/MemberCard.astro'
import { getCollection } from 'astro:content'
import ActivityCard from '@components/ActivityCard.astro'

const { slug } = Astro.params
const departments = await getCollection('departments')
const dept = departments.find((d) => d.slug === slug)
const hasIntro = !!(dept && (
  Array.isArray(dept.data.intro)
    ? dept.data.intro.some((p) => typeof p === 'string' && p.trim().length > 0)
    : typeof dept.data.intro === 'string' && dept.data.intro.trim().length > 0
))
if (!dept || !hasIntro) {
  Astro.response.status = 404
}
const members = await getCollection('members')
const deptMembers = members
  .filter((m) => (m.slug.split('/')[0] === slug))
  .sort((a, b) => {
    const weight = (p?: string) =>
      p === 'minister' ? 0 : p === 'vice-minister' ? 1 : 2
    const wa = weight(a.data.position)
    const wb = weight(b.data.position)
    if (wa !== wb) return wa - wb
    return a.data.name.localeCompare(b.data.name, 'zh')
  })

type GalleryEntry = { slug: string; data: { date: Date; image: string; intro: string; link?: string } }
const gallery = (await getCollection('deptGallery' as any) as unknown as GalleryEntry[])
  .filter((g) => g.slug.split('/')[0] === slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const fmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })

// 统一改用 activity 集合（兼容旧字段：linkedActivities / linkedEvents）
const allActivities: any[] = await (getCollection as any)('activity')
const activityMap = new Map(allActivities.map((e) => [e.slug, e]))
const linkedActivities: any[] = ((dept?.data.linkedActivities || dept?.data.linkedEvents || []) as string[])
  .map((s: string) => activityMap.get(s))
  .filter(Boolean)
---
{dept && hasIntro ? (
  <BaseLayout title={`${dept.data.title} - 关于我们 - SFA`}>
    <div class="mx-auto w-full md:w-3/4 lg:w-1/2">
    <section class="space-y-6">
      <header class="space-y-2">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100">{dept.data.title}</h1>
        {Array.isArray(dept.data.intro) ? (
          dept.data.intro.map((p) => <p class="text-slate-700 dark:text-slate-300 leading-7">{p}</p>)
        ) : (
          dept.data.intro ? <p class="text-slate-700 dark:text-slate-300 leading-7">{dept.data.intro}</p> : null
        )}
      </header>
      {dept.data.duties?.length ? (
        <section class="space-y-3">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">主要职责</h2>
          <ul class="list-disc pl-5 space-y-1 text-slate-700 dark:text-slate-300">
            {dept.data.duties.map((d) => (<li>{d}</li>))}
          </ul>
        </section>
      ) : null}

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">部门成员</h2>
        {deptMembers.length ? (
          <div class="grid gap-4 md:grid-cols-2">
            {deptMembers.map((m) => (
              <MemberCard avatar={m.data.avatar} name={m.data.name} quote={m.data.quote} bio={m.data.bio} position={m.data.position} />
            ))}
          </div>
        ) : (
          <p class="text-slate-500 dark:text-slate-400">暂时还没有成员信息，敬请期待。</p>
        )}
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">活动</h2>
        {linkedActivities.length ? (
          <div class="grid gap-3 sm:grid-cols-2">
            {linkedActivities.slice(0, 4).map((e) => (
              <ActivityCard title={e.data.title} date={e.data.date} cover={e.data.cover} compact={true} summary={e.data.summary} />
            ))}
          </div>
        ) : (
          <p class="text-slate-500 dark:text-slate-400">暂时还没有该部门相关的活动。</p>
        )}
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">画廊</h2>
        {gallery.length ? (
          <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 [column-fill:_balance]">
            {gallery.map((item) => (
              <article class="mb-4 break-inside-avoid rounded-lg border border-slate-200 dark:border-[#2c2c2e] bg-white/90 dark:bg-[#2c2c2e]/60 shadow-sm overflow-hidden">
                <div class="relative">
                  <img src={item.data.image} alt={item.data.intro} class="w-full h-auto block" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid'" />
                  <div class="hidden place-items-center w-full aspect-[4/3] bg-slate-100 dark:bg-[#2c2c2e] text-slate-400 dark:text-slate-500 text-sm">图片缺失</div>
                </div>
                <div class="p-3 space-y-1">
                  <time class="text-xs text-slate-500 dark:text-slate-400">{fmt(item.data.date)}</time>
                  <p class="text-sm leading-6 text-slate-700 dark:text-slate-300">{item.data.intro}</p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="text-slate-500 dark:text-slate-400">暂时还没有画廊内容。</p>
        )}
      </section>
    </section>
    </div>
  </BaseLayout>
) : (
  <NotFound />
)}
