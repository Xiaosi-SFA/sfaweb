---
import BaseLayout from '@layouts/BaseLayout.astro'
import DeptCard from '@components/DeptCard.astro'
import MemberCard from '@components/MemberCard.astro'
import TestMemberCard from '@components/TestMemberCard.astro'
import { getCollection } from 'astro:content'
import '@styles/about.css'
import MarkdownContent from '@components/MarkdownContent.astro'

const aboutEntry = (await (getCollection as any)('about')).find((x: any) => x.slug === 'index')
const { Content } = aboutEntry ? await aboutEntry.render() : { Content: null }

const departments = (await getCollection('departments')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
)
---
<BaseLayout title="关于我们 - SFA">
  <!--
    成员介绍卡片（测试，已注释）
    <section class="w-full">
      <div class="mx-auto w-full px-4 sm:px-6 lg:px-8">
        <div class="mx-auto w-full sm:w-2/3 lg:w-1/2">
          <TestMemberCard name="Specialist专家可在线一对一帮您选购" subtitle="" label="SFA Specilist专家" avatar="/avatar/copywriting/ymz.jpg" />
        </div>
      </div>
    </section>
  -->

  <div class="mx-auto w-full md:w-3/4 lg:w-1/2">
    <section class="space-y-8">
      <header class="space-y-2">
        <h1 class="text-3xl font-bold">{aboutEntry?.data.title ?? '关于我们'}</h1>
        {aboutEntry?.data.intro ? (
          <p class="text-slate-600 dark:text-slate-300">{aboutEntry.data.intro}</p>
        ) : null}
      </header>

      {Content ? (
        <MarkdownContent Content={Content} variant="about" align={aboutEntry?.data?.align} />
      ) : null}
      <section class="space-y-3">
        <h2 class="text-xl font-semibold">部门简介</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 dept-grid">
          {departments.map((d) => (
            <DeptCard title={d.data.title} summary={d.data.summary ?? ''} href={`/about/departments/${d.slug}/`} />
          ))}
        </div>
      </section>
    </section>
  </div>
</BaseLayout>
