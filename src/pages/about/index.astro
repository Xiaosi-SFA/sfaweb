---
import BaseLayout from '@layouts/BaseLayout.astro'
import DeptCard from '@components/DeptCard.astro'
import { getCollection } from 'astro:content'

const aboutEntry = (await (getCollection as any)('about')).find((x: any) => x.slug === 'index')
const { Content } = aboutEntry ? await aboutEntry.render() : { Content: null }

const departments = (await getCollection('departments')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
)
---
<BaseLayout title="关于我们 - SFA">
  <div class="mx-auto w-full md:w-3/4 lg:w-1/2">
    <section class="space-y-8">
      <header class="space-y-2">
        <h1 class="text-3xl font-bold">{aboutEntry?.data.title ?? '关于我们'}</h1>
        {aboutEntry?.data.intro ? (
          <p class="text-slate-600">{aboutEntry.data.intro}</p>
        ) : null}
      </header>

      {Content ? (
        <article class="prose article-prose max-w-none">
          <Content />
        </article>
      ) : null}

      <section class="space-y-3">
        <h2 class="text-xl font-semibold">部门与小组</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {departments.map((d) => (
            <DeptCard title={d.data.title} summary={d.data.summary ?? ''} href={`/about/departments/${d.slug}/`} />
          ))}
        </div>
      </section>
    </section>
  </div>
</BaseLayout>
