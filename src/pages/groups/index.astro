---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import MemberCard from '@components/MemberCard.astro'
import ActivityCard from '@components/ActivityCard.astro'

const groups = (await getCollection('groups')).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
const items = await Promise.all(
  groups.map(async (g) => ({
    entry: g,
    hasBody: !!(g.body && g.body.trim().length > 0),
    Render: (await g.render()).Content,
  }))
)

const activities: any[] = await (getCollection as any)('activity')
const activityMap = new Map(activities.map((e) => [e.slug, e]))

function initials(title: string) {
  return title.slice(0, 2)
}
---
<BaseLayout title="兴趣小组 - SFA">
  <section class="space-y-6">
    <header class="text-center space-y-2">
      <h1 class="text-3xl font-bold">兴趣小组</h1>
      <p class="text-slate-600">加入一个小组，和同好一起探索更远的科幻宇宙。</p>
    </header>

    <div class="flex flex-col items-center gap-6">
      {items.map((it, idx) => {
        const { entry: g, hasBody, Render } = it
        return (
  <article data-idx={idx} class="group-card w-full max-w-2xl rounded-xl border border-slate-200 dark:border-[#2c2c2e] bg-white/90 dark:bg-[#2c2c2e]/60 shadow-sm overflow-hidden">
          <div class="p-5 sm:p-6 space-y-5">
            {/* 顶部：双栏布局（左：标题与简介；右：大头像 占 1/3） */}
            <div class="grid gap-5 md:grid-cols-3 items-start">
              <div class="md:col-span-1">
                <div class="aspect-square w-full rounded-lg ring-1 ring-slate-200 dark:ring-[#2c2c2e] bg-slate-100 dark:bg-[#2c2c2e] overflow-hidden grid place-items-center">
                  {g.data.avatar ? (
                    <img src={g.data.avatar} alt={g.data.title} class="h-full w-full object-cover" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid'" />
                  ) : null}
                  <div class={`h-full w-full ${g.data.avatar ? 'hidden' : ''} grid place-items-center text-slate-400 dark:text-slate-500 text-lg`}>{initials(g.data.title)}</div>
                </div>
              </div>
              <div class="min-w-0 space-y-2 md:col-span-2">
                <h2 class="text-2xl font-semibold text-slate-800 dark:text-slate-200 truncate">{g.data.title}</h2>
                {hasBody ? (
                  <div class="text-slate-700 dark:text-slate-300 leading-7">
                    <Render />
                  </div>
                ) : (
                  <p class="text-slate-700 dark:text-slate-300 leading-7">{g.data.intro}</p>
                )}
                <div class="mt-2">
                  <h3 class="text-sm font-medium text-slate-600 dark:text-slate-400">主要活动</h3>
                  <ul class="mt-1 list-disc pl-5 text-slate-700 dark:text-slate-300 space-y-1">
                    {g.data.activities.map((a) => (<li>{a}</li>))}
                  </ul>
                </div>
              </div>
            </div>

            {/* 中段：组长卡片（单栏通栏） */}
            {g.data.leader ? (
              <div>
                <MemberCard avatar={g.data.leader.avatar} name={g.data.leader.name} quote={g.data.leader.quote} bio={g.data.leader.bio} labelOverride="组长" />
              </div>
            ) : null}

            {/* 底部：活动列表（双栏） */}
            {(g.data.linkedActivities?.length || g.data.linkedEvents?.length) ? (
              <div>
                <h3 class="text-sm font-medium text-slate-600 mb-2">活动</h3>
                <div class="grid gap-3 sm:grid-cols-2">
                  {((g.data.linkedActivities || g.data.linkedEvents || []) as string[])
                    .map((slug: string) => activityMap.get(slug))
                    .filter(Boolean)
                    .slice(0, 4)
                    .map((e: any) => (
                      <a href={`/activity/${e.slug}/`} class="block">
                        <ActivityCard
                          title={e.data.title}
                          date={e.data.date}
                          cover={e.data.cover}
                          summary={e.data.summary}
                          compact={true}
                        />
                      </a>
                    ))}
                </div>
              </div>
            ) : null}
          </div>
        </article>
        )
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .group-card {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .6s cubic-bezier(.22,.61,.36,1), transform .6s cubic-bezier(.22,.61,.36,1);
    will-change: opacity, transform;
  }
  .group-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .group-card { transition: none; transform: none; opacity: 1; }
  }
</style>

<script is:inline>
  const cards = Array.from(document.querySelectorAll('.group-card'))
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        const idx = Number(e.target.getAttribute('data-idx') || '0')
        const delay = Math.min(idx * 80, 320) // 逐个延迟，最多 320ms
        e.target.style.transitionDelay = `${delay}ms`
        e.target.classList.add('is-visible')
        io.unobserve(e.target)
      }
    }
  }, { threshold: 0.15 })
  cards.forEach((el) => io.observe(el))
</script>
