---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PostCard from '@components/PostCard.astro'
import ActivityCard from '@components/ActivityCard.astro'
import { withBase } from '@utils/path'
import '@styles/homepage.css'

const latestArticles = (await (getCollection as any)('articles'))
  .sort((a: any, b: any) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 6)

const latestActivity = (await (getCollection as any)('activity'))
  .filter((e: any) => e.slug.includes('/'))
  .sort((a: any, b: any) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 3)
---
<BaseLayout title="四川大学科幻协会">
  <section class="hero-anim relative min-h-screen p-8 md:p-12 overflow-visible flex items-center justify-center">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center justify-center" style="min-height:60vh;">
      <div class="logo-wrap hero-logo-wrap mx-auto mb-6 w-full flex items-center justify-center">
        <img src={withBase('/xiaosi.png')} alt="SFA logo" class="w-auto h-40 sm:h-48 md:h-56 object-contain block dark:hidden" />
        <img src={withBase('/xiaosi.png')} alt="SFA logo night" class="w-auto h-40 sm:h-48 md:h-56 object-contain hidden dark:block" />
      </div>

      <h1 id="welcomeText" class="welcome-text text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mt-4 text-slate-900 dark:text-slate-100">欢迎来到小四的机密档案室</h1>

      <div class="welcome-actions mt-8 flex items-center justify-center gap-4">
        <a href="#latest-articles" class="px-6 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-slate-100 dark:text-slate-900 font-semibold text-sm shadow-md transition-all duration-300 hover:scale-105">文章</a>
        <a href="#latest-activity" class="px-6 py-2.5 rounded-full liquid-pill text-slate-800 dark:text-slate-100 font-semibold text-sm transition-all duration-300 hover:scale-105">活动</a>
      </div>

      <div class="w-full flex flex-col items-center justify-center mt-20">
        <button aria-label="查看内容" class="arrow-wrap bg-transparent border-0 cursor-pointer w-14 h-14 p-0 m-0 flex items-center justify-center">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="animate-bounce-up w-10 h-10 block text-slate-900 dark:text-slate-100" aria-hidden="true">
            <path d="M12 6 L6 12 H18 L12 6 Z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </div>


    <style>
      .logo-wrap img { transition: transform 800ms cubic-bezier(.2,.8,.2,1); transform: translateY(0); }
      .welcome-text { opacity: 0; transform: translateY(8px); transition: opacity 480ms ease 380ms, transform 480ms ease 380ms; }
      .hero-anim.loaded .logo-wrap img { transform: translateY(-48px); }
      .hero-anim.loaded .welcome-text { opacity: 1; transform: translateY(0); }

      .arrow-wrap { opacity: 0; transform: translateY(8px); transition: opacity 360ms ease, transform 360ms ease; pointer-events: none; display:inline-flex; }
      .arrow-caption { opacity: 0; transform: translateY(8px); transition: opacity 360ms ease, transform 360ms ease; }
      .hero-anim.loaded .arrow-wrap { opacity: 1; transform: translateY(16px); pointer-events: auto; }
      .hero-anim.loaded .arrow-caption { opacity: 1; transform: translateY(16px); }

      @keyframes bounceUp { 0%{transform:translateY(0)}50%{transform:translateY(-8px)}100%{transform:translateY(0)} }
      .animate-bounce-up { animation: bounceUp 1.6s infinite ease-in-out; }
    </style>

    <script>
      let cleanupHomepage: (() => void) | null = null;

      document.addEventListener('astro:page-load', () => {
        const hero = document.querySelector('.hero-anim');
        const arrow = document.querySelector('.arrow-wrap');
        const firstSection = document.getElementById('latest-articles');
        if (!hero) return;

        const loadTimer = setTimeout(() => hero.classList.add('loaded'), 600);

        function ensureHeaderVisible() {
          if (document.body.classList.contains('hide-header-footer')) {
            document.body.classList.remove('hide-header-footer');
          }
        }

        function scrollToFirst() {
          ensureHeaderVisible();
          if (firstSection) firstSection.scrollIntoView({ behavior: 'smooth' });
        }

        arrow?.addEventListener('click', scrollToFirst);

        const isAtTop = () => (window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0) < 4;

        const wheelHandler = (e: WheelEvent) => {
          if (e.deltaY > 20 && isAtTop()) {
            removeAccelerators();
            scrollToFirst();
            return;
          }
          if (e.deltaY < -20) {
            ensureHeaderVisible();
          }
        };
        window.addEventListener('wheel', wheelHandler, { passive: true });

        let startY: number | null = null;
        const onTouchStart = (e: TouchEvent) => { startY = e.touches[0].clientY; };
        const onTouchMove = (e: TouchEvent) => {
          if (startY == null) return;
          const current = e.touches[0].clientY;
          const dy = startY - current;
          if (dy > 40 && isAtTop()) {
            removeAccelerators();
            scrollToFirst();
            startY = null;
            return;
          }
          if (dy < -40) {
            ensureHeaderVisible();
          }
        };
        window.addEventListener('touchstart', onTouchStart, { passive: true });
        window.addEventListener('touchmove', onTouchMove, { passive: true });

        function removeAccelerators() {
          try { window.removeEventListener('wheel', wheelHandler); } catch(_) {}
          try { window.removeEventListener('touchstart', onTouchStart); } catch(_) {}
          try { window.removeEventListener('touchmove', onTouchMove); } catch(_) {}
        }

        const sections = [
          { id: 'latest-articles', path: '/articles/' },
          { id: 'latest-activity', path: '/activity/' }
        ];
        const pairs = sections.map(s => ({
          el: document.getElementById(s.id),
          link: Array.from(document.querySelectorAll('.site-header .nav-link')).find(a => a.getAttribute('href')?.endsWith(s.path))
        })).filter((p): p is { el: HTMLElement; link: Element } => !!p.el && !!p.link);

        let homeLink = Array.from(document.querySelectorAll('.site-header .nav-link')).find(a => {
          const href = a.getAttribute('href') || '';
          return href === '/' || /^\/[a-z]{2}(?:-[a-z]{2})?\/$/i.test(href);
        });

        const ratios = new Map<Element, number>();
        function updateActive() {
          let best = { r: 0, link: null as Element | null };
          for (const p of pairs) {
            const r = ratios.get(p.el) || 0;
            if (r > best.r) best = { r, link: p.link };
          }
          pairs.forEach(p => p.link.classList.remove('is-active'));
          homeLink?.classList.remove('is-active');
          if (best.link && best.r > 0.15) {
            best.link.classList.add('is-active');
          } else {
            homeLink?.classList.add('is-active');
          }
        }

        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            ratios.set(entry.target, entry.intersectionRatio);
          }
          updateActive();
        }, { threshold: [0, 0.25, 0.5, 0.75, 1], rootMargin: '-30% 0px -50% 0px' });

        pairs.forEach(p => io.observe(p.el));
        updateActive();

        cleanupHomepage = () => {
          clearTimeout(loadTimer);
          removeAccelerators();
          io.disconnect();
        };
      });

      document.addEventListener('astro:before-swap', () => {
        if (cleanupHomepage) {
          cleanupHomepage();
          cleanupHomepage = null;
        }
      });
    </script>
  </section>

  <section id="latest-articles" class="py-16 md:py-20 border-t border-black/[0.04] dark:border-white/[0.06]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-black/[0.06] dark:border-white/[0.08]">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">文章</h2>
        <a href={withBase('/articles/')} class="inline-flex items-center gap-1 text-sm font-semibold text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 group">
          全部
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {latestArticles.map((a: any) => (
          <PostCard href={`/articles/${a.slug}/`} title={a.data.title} date={a.data.date} cover={a.data.cover} tags={a.data.tags} summary={a.data.summary} />
        ))}
      </div>
    </div>
  </section>

  <section id="latest-activity" class="py-16 md:py-20 border-t border-black/[0.04] dark:border-white/[0.06]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-black/[0.06] dark:border-white/[0.08]">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">活动</h2>
        <a href={withBase('/activity/')} class="inline-flex items-center gap-1 text-sm font-semibold text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 group">
          全部
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid gap-6 grid-cols-1 md:grid-cols-3">
        {latestActivity.map((e: any) => (
          <ActivityCard
            href={`/activity/${e.slug}/`}
            title={e.data.title}
            date={e.data.date}
            cover={e.data.cover}
            summary={e.data.summary}
            tags={e.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
