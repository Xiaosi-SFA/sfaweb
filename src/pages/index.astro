---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PostCard from '@components/PostCard.astro'
import ActivityCard from '@components/ActivityCard.astro'

// 最新文章（按日期降序，取前 6 条）
const latestArticles = (await (getCollection as any)('articles'))
  .sort((a: any, b: any) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 6)

// 最近活动（仅使用嵌套 slug 的事件，避免与旧单段路由重复；取前 6 条）
const latestEvents = (await (getCollection as any)('events'))
  .filter((e: any) => e.slug.includes('/'))
  .sort((a: any, b: any) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 6)
---
<BaseLayout title="小四的机密档案库" hideHeaderFooter>
  <!-- Hero 欢迎区（无背景、居中 Logo、欢迎语、向上箭头） -->
  <section class="hero-anim relative min-h-screen p-8 md:p-12 overflow-visible flex items-center justify-center">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center justify-center" style="min-height:60vh;">
  <div class="logo-wrap mx-auto mb-6 w-full" style="max-width: min(600px, 60vw); overflow:visible;">
        <div style="aspect-ratio:16/9; width:100%;" class="rounded-md">
          <img id="heroLogo" src="/logo1.png" alt="SFA logo" class="w-full h-full object-cover block" />
        </div>
      </div>

      <h1 id="welcomeText" class="welcome-text text-2xl md:text-3xl font-extrabold mt-2">欢迎来到小四的机密档案室</h1>

      <!-- 向上箭头，放在一个宽度 100% 的容器内以确保与 logo 精确居中对齐 -->
      <div class="w-full flex justify-center mt-24">
        <button aria-label="上滑查看最新消息" class="arrow-wrap bg-transparent border-0 cursor-pointer w-14 h-14 p-0 m-0 flex items-center justify-center">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="animate-bounce-up w-10 h-10 block" aria-hidden="true">
            <!-- 向上三角形，居中显示 -->
            <path d="M12 6 L6 12 H18 L12 6 Z" fill="#0f172a" />
          </svg>
        </button>
      </div>
    </div>
    

    <style>
      .logo-wrap img { transition: transform 800ms cubic-bezier(.2,.8,.2,1); transform: translateY(0); }
      .welcome-text { opacity: 0; transform: translateY(8px); transition: opacity 480ms ease 380ms, transform 480ms ease 380ms; }
      /* 上移距离调整为 -48px，并确保容器不裁切图片 */
      .hero-anim.loaded .logo-wrap img { transform: translateY(-48px); }
      .hero-anim.loaded .welcome-text { opacity: 1; transform: translateY(0); }

  /* 向上箭头默认隐藏，动画完成后显示并可交互 */
  .arrow-wrap { opacity: 0; transform: translateY(8px); transition: opacity 360ms ease, transform 360ms ease; pointer-events: none; display:inline-flex; }
  /* 显示时下移 16px，使箭头位置更低 */
  .hero-anim.loaded .arrow-wrap { opacity: 1; transform: translateY(16px); pointer-events: auto; }

      /* 向上箭头浮动动画（当可见时） */
      @keyframes bounceUp { 0%{transform:translateY(0)}50%{transform:translateY(-8px)}100%{transform:translateY(0)} }
      .animate-bounce-up { animation: bounceUp 1.6s infinite ease-in-out; }
    </style>

    <script type="module">
      // 加载动画与上滑检测：支持鼠标滚轮和触摸滑动（上划手势）
      document.addEventListener('DOMContentLoaded', () => {
        const hero = document.querySelector('.hero-anim');
        const arrow = document.querySelector('.arrow-wrap');
  const firstSection = document.getElementById('latest-articles');

        setTimeout(() => hero.classList.add('loaded'), 600);

        function scrollToFirst() {
          // reveal header/footer (they are initially hidden via body.hide-header-footer)
          document.body.classList.remove('hide-header-footer');
          if (firstSection) firstSection.scrollIntoView({ behavior: 'smooth' });
        }

        arrow?.addEventListener('click', scrollToFirst);

        // 鼠标滚轮向下（用户上滑页面内容）
  let wheelHandler = (e) => { if (e.deltaY > 20) { scrollToFirst(); window.removeEventListener('wheel', wheelHandler); } };
        window.addEventListener('wheel', wheelHandler, { passive: true });

        // 触摸：记录起始触点，检测上滑（手指向上移动，dy > 30）
        let startY = null;
        window.addEventListener('touchstart', (e) => startY = e.touches[0].clientY, { passive: true });
        window.addEventListener('touchmove', (e) => {
          if (startY == null) return;
          const current = e.touches[0].clientY;
          const dy = startY - current;
          if (dy > 40) { scrollToFirst(); startY = null; }
        }, { passive: true });
      });
    </script>
  </section>

  <!-- 最新文章（上滑进入） -->
  <section id="latest-articles" class="py-12 bg-slate-50 dark:bg-[#1c1c1e]">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-semibold mb-6">最新文章</h2>
      <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {latestArticles.map((a: any) => (
          <PostCard href={`/articles/${a.slug}/`} title={a.data.title} date={a.data.date} cover={a.data.cover} tags={a.data.tags} summary={a.data.summary} />
        ))}
      </div>
    </div>
  </section>

  <!-- 最近活动（使用与时间轴相同的卡片） -->
  <section id="latest-events" class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl font-semibold mb-6">最近活动</h2>
      <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {latestEvents.map((e: any) => (
          <a href={`/events/${e.slug}/`} class="block">
            <ActivityCard title={e.data.title}
              date={e.data.date}
              cover={e.data.cover}
              summary={e.data.summary}
              tags={e.data.tags}
            />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
