---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import TOC from '@components/TOC.astro'
import RelatedPosts from '@components/RelatedPosts.astro'
import BackToTopOrb from '@components/BackToTopOrb.astro'
import NotFound from '@components/NotFound.astro'
import '@styles/article.css'
import MarkdownContent from '@components/MarkdownContent.astro'

const { slug } = Astro.params
const entry = (await getCollection('articles')).find((e) => e.slug === slug)
let Content, headings: Array<{ depth: number; text: string; slug: string }> = []

if (entry) {
  const rendered = await entry.render()
  ;({ Content, headings } = rendered)
} else {
  Astro.response.status = 404
}

// Feature flag from config: optional paragraph first-line indent via CSS variable
import siteConfig from '../../../sfa.config.json'
const ENABLE_INDENT = Boolean((siteConfig as any)?.ui?.enableIndent)
const paraIndent = ENABLE_INDENT ? Number(entry?.data?.int ?? entry?.data?.indent ?? 0) || 0 : 0
---
{entry ? (
  <BaseLayout title={`${entry.data.title} - SFA`}>
    {/* grid: left 1/3 (sidebar), right 2/3 (content) */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="order-2 md:order-1 md:col-span-1">
    <div class="space-y-4 md:sticky md:top-24 md:max-h-[calc(100vh-6rem)] md:overflow-y-auto md:pr-1">
          <div class="hidden md:block">
            <TOC headings={headings} />
          </div>
          <RelatedPosts currentSlug={entry.slug} tags={entry.data.tags} />
        </div>
      </div>
  <article class="order-1 md:order-2 md:col-span-2 max-w-none">
        {entry.data.cover ? (
          <img
            src={entry.data.cover}
            alt={entry.data.title}
            class="w-full aspect-[16/9] object-cover rounded-md mb-4"
          />
        ) : null}
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight text-slate-900 dark:text-slate-100">{entry.data.title}</h1>
        <div class="mt-2 flex items-center justify-between text-sm text-slate-500 dark:text-slate-400">
          <div>
            {new Date(entry.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
            {entry.data.author ? ` · ${entry.data.author}` : ''}
          </div>
          <div class="hidden sm:flex gap-2">
            {entry.data.tags?.map((t: string) => (
              <span class="text-xs bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200 px-2 py-0.5 rounded">#{t}</span>
            ))}
          </div>
        </div>
        <MarkdownContent Content={Content} indent={paraIndent} />
      </article>
    </div>
    <BackToTopOrb />
  </BaseLayout>
) : (
  <NotFound />
)}
