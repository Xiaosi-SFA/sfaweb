---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PostCard from '@components/PostCard.astro'
const articles = await getCollection('articles')
  .then((xs) => xs.sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)))
---
<BaseLayout title="文章 - SFA">
  <h1 class="text-2xl font-bold mb-6">文章</h1>
  <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    {articles.map((a) => (
      <PostCard href={`/articles/${a.slug}/`} title={a.data.title} date={a.data.date} cover={a.data.cover} tags={a.data.tags} summary={a.data.summary} />
    ))}
  </div>
</BaseLayout>
