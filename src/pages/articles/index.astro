---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
const articles = await getCollection('articles')
  .then((xs) => xs.sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)))
---
<BaseLayout title="文章 - SFA">
  <h1 class="text-2xl font-bold mb-6">文章</h1>
  <ul class="space-y-4">
    {articles.map((a) => (
      <li class="p-4 bg-white rounded-lg shadow-sm border">
        <a class="block" href={`/articles/${a.slug}/`}>
          <div class="text-sm text-slate-500">
            {a.data.date?.toISOString().slice(0,10)} · {a.data.author}
          </div>
          <h2 class="text-lg font-semibold">{a.data.title}</h2>
          {a.data.summary && <p class="text-slate-600 mt-1">{a.data.summary}</p>}
          {a.data.tags?.length ? (
            <div class="mt-2 flex gap-2 flex-wrap">
              {a.data.tags.map((t) => (
                <a href={`/tags/${encodeURIComponent(t)}/`} class="text-xs bg-slate-100 text-slate-700 px-2 py-0.5 rounded hover:bg-slate-200">#{t}</a>
              ))}
            </div>
          ) : null}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
