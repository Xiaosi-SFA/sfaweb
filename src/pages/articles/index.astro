---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PostCard from '@components/PostCard.astro'
import SectionHeader from '@components/SectionHeader.astro'
import '@styles/articles.css'

const SECTION_META = [
  {
    slugPrefix: 'contributions',
    title: '投稿',
    description: '来自成员与伙伴的真实之作，汇聚多元视角，传递思考与温度。',
    link: '/articles/contributions/',
    linkLabel: '更多',
  },
  {
    slugPrefix: 'essays',
    title: '杂谈',
    description: '轻松的随笔与片刻的灵感，记录活动背后的心绪与社团的每一步成长。',
    link: '/articles/essays/',
    linkLabel: '更多',
  },
  {
    slugPrefix: 'reviews',
    title: '影评 / 书评',
    description: '以从容的目光解读作品，洞见科幻想象力，并发现它启发我们的方式。',
    link: '/articles/reviews/',
    linkLabel: '更多',
  },
  {
    slugPrefix: 'classics',
    title: '诗歌 / 古文',
    description: '诗词古文与现代诗，文字的韵律与格调在此相遇。',
    link: '/articles/classics/',
    linkLabel: '更多',
  },
] as const

const articles = await getCollection('articles')
  .then((xs) => xs
    .filter((item) => !item.slug.includes('article-template') && !item.slug.includes(' copy'))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)))

type SectionSlug = (typeof SECTION_META)[number]['slugPrefix']
const grouped = new Map<SectionSlug, typeof articles>()
SECTION_META.forEach(({ slugPrefix }) => grouped.set(slugPrefix, []))

articles.forEach((item) => {
  const [rawPrefix] = item.slug.split('/')
  const isKnown = SECTION_META.some(({ slugPrefix }) => slugPrefix === rawPrefix)
  const key: SectionSlug = isKnown ? (rawPrefix as SectionSlug) : 'essays'
  const list = grouped.get(key)
  if (list) {
    list.push(item)
  }
})
---
<BaseLayout title="文章 - SFA">
  <section class="space-y-12">

    {SECTION_META.map(({ slugPrefix, title, description, link, linkLabel }) => {
      const list = grouped.get(slugPrefix) ?? []
      return (
        <section class="space-y-4" data-section={slugPrefix}>
          <SectionHeader title={title} description={description} link={link} linkLabel={linkLabel} />
          {list.length ? (
            <div class="horizontal-scroll overflow-x-auto -mx-4 px-4">
              <div class="articles-row flex gap-4 pb-4 snap-x snap-mandatory">
                {list.slice(0, 6).map((a, i) => (
                  <div class="min-w-[18rem] max-w-xs flex-shrink-0 snap-start post-card-anim" data-idx={i}>
                    <PostCard href={`/articles/${a.slug}/`} title={a.data.title} date={a.data.date} cover={a.data.cover} tags={a.data.tags} summary={a.data.summary} />
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <p class="text-xs text-slate-400">暂时还没有内容，欢迎稍后查看。</p>
          )}
        </section>
      )
    })}
  </section>

  

  <script is:inline>
    const cards = Array.from(document.querySelectorAll('.post-card-anim'))
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible')
          io.unobserve(e.target)
        }
      }
    }, { threshold: 0.2 })
    cards.forEach((el) => io.observe(el))
  </script>
</BaseLayout>
