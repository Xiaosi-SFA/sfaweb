---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PostCard from '@components/PostCard.astro'

const CATEGORY = {
  slugPrefix: 'contributions',
  title: '投稿',
  description: '成员与朋友们的原创投稿，记录真实的思考、经历与灵感。',
  empty: '暂时还没有投稿内容，欢迎向我们分享你的故事。',
} as const

const articles = await getCollection('articles')
  .then((xs) => xs
    .filter((item) => !item.slug.includes('article-template'))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)))

const filtered = articles.filter((item) => item.slug.startsWith(`${CATEGORY.slugPrefix}/`))
---
<BaseLayout title={`${CATEGORY.title}栏目 - 文章 - SFA`}>
  <section class="space-y-8">
    <header class="space-y-4">
      <div class="topic-divider">
        <span class="topic-divider__label">{CATEGORY.title}</span>
      </div>
      <p class="text-slate-600 dark:text-slate-300 max-w-3xl text-sm md:text-base">{CATEGORY.description}</p>
    </header>

    {filtered.length ? (
      <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {filtered.map((a) => (
          <PostCard
            href={`/articles/${a.slug}/`}
            title={a.data.title}
            date={a.data.date}
            cover={a.data.cover}
            tags={a.data.tags}
            summary={a.data.summary}
          />
        ))}
      </div>
    ) : (
      <p class="text-slate-500 dark:text-slate-400">{CATEGORY.empty}</p>
    )}
  </section>
</BaseLayout>
