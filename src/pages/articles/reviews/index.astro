---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PostCard from '../../../components/PostCard.astro'

const CATEGORY = {
  slugPrefix: 'reviews',
  title: '影评 / 书评',
  description: '从经典科幻到新锐作品，记录我们的观后感与阅读心得。',
  empty: '暂时还没有影评或书评，欢迎投稿分享。',
} as const

const articles = await getCollection('articles')
  .then((xs) => xs
    .filter((item) => !item.slug.includes('article-template'))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)))

const filtered = articles.filter((item) => item.slug.startsWith(`${CATEGORY.slugPrefix}/`))
---
<BaseLayout title={`${CATEGORY.title}栏目 - 文章 - SFA`}>
  <section class="space-y-8">
    <header class="space-y-4">
      <div class="flex items-center gap-3">
        <span class="hidden sm:block h-[2px] flex-1 bg-sky-200" aria-hidden="true"></span>
        <span class="inline-flex items-center gap-2 rounded-full border border-sky-400 bg-sky-50 px-4 py-1 text-xs font-semibold tracking-[0.3em] text-sky-600 uppercase">{CATEGORY.title}</span>
        <span class="h-[2px] flex-1 bg-sky-200" aria-hidden="true"></span>
      </div>
      <p class="text-slate-600 max-w-3xl text-sm md:text-base">{CATEGORY.description}</p>
    </header>

    {filtered.length ? (
      <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {filtered.map((a) => (
          <PostCard
            href={`/articles/${a.slug}/`}
            title={a.data.title}
            date={a.data.date}
            cover={a.data.cover}
            tags={a.data.tags}
            summary={a.data.summary}
          />
        ))}
      </div>
    ) : (
      <p class="text-slate-500">{CATEGORY.empty}</p>
    )}
  </section>
</BaseLayout>
