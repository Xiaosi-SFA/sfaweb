---
interface Props {
  title?: string;
  description?: string;
  hideHeaderFooter?: boolean;
  disableWaveBg?: boolean;
}
import WaveBackground from '@components/WaveBackground.astro'
import '@styles/global.css'
const {
  title = "SFA 社团",
  description = "社团官网与消息门户",
  hideHeaderFooter = false,
  disableWaveBg = false,
} = Astro.props as Props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class={`min-h-screen bg-slate-50 text-slate-900 ${hideHeaderFooter ? 'hide-header-footer' : ''}`}>
    {!disableWaveBg && <WaveBackground />}
    <header
      class="site-header border-b bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/60 sticky top-0 z-10"
    >
      <nav class="mx-auto max-w-6xl px-4 py-3 flex items-center gap-6">
        <a href="/" class="flex items-center gap-2">
          <img src="/logo.png" alt="SFA" width="32" height="32" class="w-8 h-8" />
          <span class="sr-only">SFA</span>
        </a>
        <a href="/articles/" class="hover:text-brand-dark">文章</a>
        <a href="/news/" class="hover:text-brand-dark">消息</a>
        <a href="/events/" class="hover:text-brand-dark">事件</a>
        <a href="/links/" class="hover:text-brand-dark ml-auto md:ml-0">友链</a>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8 relative z-0">
      <slot />
    </main>
    <footer
      class="site-footer border-t py-6 text-center text-sm text-slate-500"
    >
      © {new Date().getFullYear()} SFA 社团
    </footer>
  </body>
</html>
