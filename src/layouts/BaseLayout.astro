---
interface Props {
  title?: string;
  description?: string;
  hideHeaderFooter?: boolean;
}
const {
  title = "SFA 社团",
  description = "社团官网与消息门户",
  hideHeaderFooter = false,
} = Astro.props as Props;
import "../styles/global.css";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body
    class={`min-h-screen bg-slate-50 text-slate-900 ${hideHeaderFooter ? "hide-header-footer" : ""}`}
  >
    <!-- Global animated wave background -->
    <div class="wave-bg" aria-hidden="true">
      <svg
        viewBox="0 0 1200 600"
        preserveAspectRatio="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <!-- Scanning mask: a moving window reveals the ECG under it -->
          <mask id="scan-mask">
            <!-- hide all by default -->
            <rect x="0" y="0" width="1200" height="600" fill="black"></rect>
            <!-- scanning window (narrower) -->
            <rect id="scanWindow" x="-180" y="0" width="100" height="600" fill="white" class="scan-window"></rect>
          </mask>
        </defs>

        <!-- Baseline waveform (faint) -->
        <path
          class="wave-path-base"
          d="
          M0 300
          h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
          h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
          h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
          h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
          h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
          h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
        "
        ></path>

        <!-- Highlighted waveform revealed by scanning window -->
        <g mask="url(#scan-mask)">
          <path
            class="wave-path"
            d="
            M0 300
            h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
            h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
            h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
            h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
            h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
            h30 q10 -13 20 0 h20 l6 16 l6 -104 l6 104 l10 -16 h10 q20 -21 40 0 h52
          "
          ></path>
        </g>
      </svg>
    </div>
    <header
      class="site-header border-b bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/60 sticky top-0 z-10"
    >
      <nav class="mx-auto max-w-6xl px-4 py-3 flex items-center gap-6">
        <a href="/" class="font-semibold text-brand">SFA</a>
        <a href="/articles/" class="hover:text-brand-dark">文章</a>
        <a href="/news/" class="hover:text-brand-dark">消息</a>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8 relative z-0">
      <slot />
    </main>
    <footer
      class="site-footer border-t py-6 text-center text-sm text-slate-500"
    >
      © {new Date().getFullYear()} SFA 社团
    </footer>
  </body>
</html>
