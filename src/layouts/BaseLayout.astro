---
interface Props {
  title?: string
  description?: string
}
const { title = 'SFA 社团', description = '社团官网与消息门户' } = Astro.props as Props
import '../styles/global.css'
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/60 sticky top-0 z-10">
      <nav class="mx-auto max-w-6xl px-4 py-3 flex items-center gap-6">
        <a href="/" class="font-semibold text-brand">SFA</a>
        <a href="/articles/" class="hover:text-brand-dark">文章</a>
        <a href="/news/" class="hover:text-brand-dark">消息</a>
        <a href="/tags/" class="hover:text-brand-dark">标签</a>
        <a href="/api/articles.json" class="ml-auto text-xs text-slate-500 hover:text-slate-700">API</a>
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t py-6 text-center text-sm text-slate-500">
      © {new Date().getFullYear()} SFA 社团
    </footer>
  </body>
  
</html>
