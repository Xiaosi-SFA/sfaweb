---
interface Props {
  title?: string;
  description?: string;
  hideHeaderFooter?: boolean;
  disableWaveBg?: boolean;
}
import WaveBackground from "@components/WaveBackground.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import "@styles/global.css";
import { getCollection } from 'astro:content';
const {
  title = "小四的机密档案室",
  description = "社团官网与消息门户",
  hideHeaderFooter = false,
  disableWaveBg = false,
} = Astro.props as Props;

// i18n: load *.lang files (flat key=value), determine locale from URL prefix
// NOTE: Vite deprecated the 'as: \"raw\"' option. Use query + import instead to avoid warnings.
const langFiles = import.meta.glob('../content/lang/*.lang', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
function parseLang(raw: string) {
  const map: Record<string, string> = {};
  if (!raw) return map;
  raw.split(/\r?\n/).forEach((line) => {
    const s = line.trim();
    if (!s || s.startsWith('#') || s.startsWith('//')) return;
    const eq = s.indexOf('=');
    if (eq === -1) return;
    const k = s.slice(0, eq).trim();
    const v = s.slice(eq + 1).trim();
    if (k) map[k] = v;
  });
  return map;
}
const pathRaw = Astro.url.pathname;
const m = pathRaw.match(/^\/(?<lc>[a-z]{2}(?:-[a-z]{2})?)(?:\/|$)/i);
const currentLocale = (m?.groups?.lc || 'zh-cn').toLowerCase();
const localePrefix = m?.groups?.lc ? `/${currentLocale}` : '';
function loadLocale(code: string) {
  const entry = Object.entries(langFiles).find(([p]) => p.toLowerCase().endsWith(`/lang/${code}.lang`));
  return parseLang(entry ? entry[1] : '');
}
const M_CUR = loadLocale(currentLocale);
const M_EN = loadLocale('en');
function t(key: string, fallback?: string) {
  return M_CUR[key] ?? M_EN[key] ?? fallback ?? key;
}

// 当前路径与导航高亮
const path = Astro.url.pathname;
const pathNoLocale = path.replace(/^\/[a-z]{2}(?:-[a-z]{2})?(?=\/|$)/i, '') || '/';
const isHomeNormalized = pathNoLocale === '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // 主题初始化：尽可能早地设置，避免亮/暗主题的闪烁
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var d = document.documentElement;
          var preferDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && preferDark)) {
            d.classList.add('dark');
          } else {
            d.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="mask-icon" href="/favicon.svg" color="#0ea5e9" />
  </head>
  <body
    class={`min-h-screen bg-[#f5f5f7] text-[#1d1d1f] dark:bg-[#1c1c1e] dark:text-[#f2f2f7] ${hideHeaderFooter ? "hide-header-footer" : ""}`}
  >
    {!disableWaveBg && <WaveBackground />}
    <SiteHeader localePrefix={localePrefix} isHomeNormalized={isHomeNormalized} pathNoLocale={pathNoLocale} t={t} />
    <main class="mx-auto max-w-6xl px-4 py-8 relative z-0">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
