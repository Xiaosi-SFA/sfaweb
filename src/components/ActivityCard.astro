---
/**
 * ActivityCard
 * - 用途：展示单个活动卡片，支持紧凑与标准两种布局。
 * - 交互：无脚本逻辑，纯样式与静态渲染。
 * - 无障碍：img 提供 alt，时间使用 <time> 标签。
 * - 性能：封面图片懒加载；缺省封面回退到 /back.png。
 */
interface Props {
	/** 卡片标题 */
	title: string
	/** 活动/新闻日期 */
	date: Date
	/** 封面图片 URL（可选） */
	cover?: string
	/** 是否使用紧凑模式（默认 false） */
	compact?: boolean
	/** 标签列表（可选） */
	tags?: string[]
	/** 摘要（可选） */
	summary?: string
}

const { title, date, cover, compact = false, tags = [], summary } = Astro.props as Props

const fmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })

import '@styles/tag.css'
import '@styles/card.css'
---
	{compact ? (
		<article class="rounded-card border border-slate-200 dark:border-[#2c2c2e] bg-white/90 dark:bg-[#2c2c2e]/60 shadow-sm overflow-hidden">
			<div class="p-3 flex items-start gap-3">
				<div class="h-16 w-24 flex-none rounded-card bg-slate-100 dark:bg-[#2c2c2e] overflow-hidden relative grid place-items-center">
					<img
						src={cover ?? '/back.png'}
						alt={title}
						class="h-full w-full object-cover"
						loading="lazy"
						onerror="this.onerror=null;this.src='/back.png'"
					/>
				</div>
				<div class="min-w-0 space-y-1">
					<h3 class="text-sm font-medium truncate">{title}</h3>
					{summary ? (<p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2">{summary}</p>) : null}
					<div class="text-[11px] text-slate-500 dark:text-slate-400 space-x-2">
						<time>{fmt(date)}</time>
					</div>
				</div>
			</div>
		</article>
	) : (
		<article class="rounded-card border border-slate-200 dark:border-[#2c2c2e] bg-white/90 dark:bg-[#2c2c2e]/60 shadow-sm overflow-hidden">
			<div class="relative aspect-[16/9] bg-slate-100 dark:bg-[#2c2c2e] rounded-card grid place-items-center" data-card-cover>
				<img
					src={cover ?? '/back.png'}
					alt={title}
					class="h-full w-full object-cover"
					loading="lazy"
					onerror="this.onerror=null;this.src='/back.png'"
				/>
			</div>
			<div class="p-3 space-y-1.5">
				<h3 class="text-base font-semibold leading-snug line-clamp-2">{title}</h3>
				<div class="text-xs text-slate-500 dark:text-slate-400 space-x-2">
					<time>{fmt(date)}</time>
				</div>
				{tags?.length ? (
					<div class="tag-list tag-list--right">
						{tags.map((t) => (
							<a href={`/tags/${encodeURIComponent(t)}/`} class="tag tag--card">#{t}</a>
						))}
					</div>
				) : null}
				{summary ? (<p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-3">{summary}</p>) : null}
			</div>
		</article>
	)}

