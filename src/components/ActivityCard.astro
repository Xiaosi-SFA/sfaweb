---
interface Props {
	href?: string
	title: string
	date: Date
	cover?: string
	compact?: boolean
	tags?: string[]
	summary?: string
}

const { href, title, date, cover, compact = false, tags = [], summary } = Astro.props as Props

const fmt = (d: Date) => d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })

import { withBase } from '@utils/path'
import '@styles/tag.css'
import '@styles/card.css'

const resolvedHref = href ? withBase(href) : undefined
const resolvedCover = cover ? withBase(cover) : undefined
---
{compact ? (
	<article class="group rounded-2xl border border-black/[0.06] dark:border-white/[0.08] bg-white/80 dark:bg-[#2c2c2e]/60 shadow-xs hover:shadow-md backdrop-blur-md transition-all duration-300 overflow-hidden">
		<div class="p-3 flex items-start gap-3">
			{resolvedCover ? (
				<div class="h-16 w-24 flex-none rounded-xl bg-slate-100 dark:bg-[#2c2c2e] overflow-hidden relative grid place-items-center">
					{resolvedHref ? (
						<a href={resolvedHref} aria-label={title} class="block w-full h-full relative">
							<img
								src={resolvedCover}
								alt={title}
								class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
								loading="lazy"
								onerror="this.parentElement.parentElement.style.display='none';"
							/>
						</a>
					) : (
						<div class="w-full h-full relative">
							<img
								src={resolvedCover}
								alt={title}
								class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
								loading="lazy"
								onerror="this.parentElement.style.display='none';"
							/>
						</div>
					)}
				</div>
			) : null}
			<div class="min-w-0 space-y-1 flex-1">
				<h3 class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-100 group-hover:text-sky-500 transition-colors truncate">
					{resolvedHref ? <a href={resolvedHref}>{title}</a> : title}
				</h3>
				{summary ? (<p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed">{summary}</p>) : null}
				<div class="text-[11px] text-slate-500 dark:text-slate-400">
					<time datetime={date ? new Date(date).toISOString() : ''}>{fmt(date)}</time>
				</div>
			</div>
		</div>
	</article>
) : (
	<article class="group rounded-2xl border border-black/[0.06] dark:border-white/[0.08] bg-white/80 dark:bg-[#2c2c2e]/60 shadow-xs hover:shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-1 overflow-hidden flex flex-col h-full">
		{resolvedCover && (
			<div class="relative aspect-[16/9] w-full overflow-hidden bg-slate-100 dark:bg-[#2c2c2e] grid place-items-center" data-card-cover>
				{resolvedHref ? (
					<a href={resolvedHref} aria-label={title} class="block w-full h-full relative">
						<img
							src={resolvedCover}
							alt={title}
							class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
							onerror="this.parentElement.parentElement.style.display='none';"
						/>
					</a>
				) : (
					<div class="w-full h-full relative">
						<img
							src={resolvedCover}
							alt={title}
							class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
							loading="lazy"
							onerror="this.parentElement.style.display='none';"
						/>
					</div>
				)}
			</div>
		)}
		<div class="p-5 flex flex-col flex-1 justify-between">
			<div>
				<div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-2">
					<time datetime={date ? new Date(date).toISOString() : ''}>{fmt(date)}</time>
				</div>
				<h3 class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100 leading-snug line-clamp-2 group-hover:text-sky-500 transition-colors">
					{resolvedHref ? <a href={resolvedHref}>{title}</a> : title}
				</h3>
				{summary ? (<p class="mt-2 text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">{summary}</p>) : null}
			</div>
			{tags?.length ? (
				<div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/[0.06] tag-list tag-list--right">
					{tags.map((t) => (
						<a href={withBase(`/tags/${encodeURIComponent(t)}/`)} class="tag tag--card">#{t}</a>
					))}
				</div>
			) : null}
		</div>
	</article>
)}
