---
import siteConfig from '../../sfa.config.json'
import '@styles/markdown.css'

interface Heading { depth: number; text: string; slug: string }

const {
	Content,
	paragraphs,
	proseClass,
	indent = 0,
	variant = 'article',
	align = undefined,
}: {
	Content?: any
	paragraphs?: string | string[]
	proseClass?: string
	indent?: number
	variant?: 'article' | 'activity' | 'about' | 'plain'
	align?: 'left' | 'center' | 'right' | string
} = Astro.props

const ENABLE_INDENT = Boolean((siteConfig as any)?.ui?.enableIndent)
const IND = ENABLE_INDENT ? (Number(indent) || 0) : 0
const defaultClassByVariant: Record<string, string> = {
	article: 'prose article-prose max-w-none mt-6',
	activity: 'prose article-prose max-w-none mt-6',
	about: 'prose article-prose max-w-none',
	plain: 'max-w-none mt-6',
}
const cls = proseClass ?? defaultClassByVariant[variant] ?? defaultClassByVariant.article
const alignMap: Record<string, string> = {
	left: 'doc-align-left',
	center: 'doc-align-center',
	right: 'doc-align-right',
}
const alignCls = align ? (alignMap[String(align).toLowerCase()] ?? '') : ''

---

<div class={`${cls} ${alignCls}`} data-indent={IND > 0 ? 'true' : 'false'} style={IND > 0 ? `--para-indent: ${IND}em` : undefined}>
	{Content ? (
		<Content />
	) : Array.isArray(paragraphs) ? (
		paragraphs.filter((p) => typeof p === 'string' && p.trim().length > 0).map((p) => (<p>{p}</p>))
	) : typeof paragraphs === 'string' && paragraphs.trim().length > 0 ? (
		<p>{paragraphs}</p>
	) : null}
</div>

<style>
	:global(.article-prose[data-indent="true"]) p {
		text-indent: var(--para-indent);
	}
</style>
