---
interface Props {
  localePrefix?: string;
  currentLocale?: string;
  isHomeNormalized: boolean;
  pathNoLocale: string;
  t: (key: string, fallback?: string) => string;
}
const { localePrefix = '', currentLocale = 'zh-cn', isHomeNormalized, pathNoLocale, t } = Astro.props as Props;
import { withBase } from '@utils/path';

const isSection = (prefix: string) => pathNoLocale === prefix || pathNoLocale.startsWith(prefix);
const navBase = "relative inline-flex items-center py-2 px-3 text-[13px] sm:text-sm font-medium tracking-tight rounded-full transition-colors nav-link text-slate-700 dark:text-slate-200 hover:text-black dark:hover:text-white";
const navActive = "bg-black/[0.05] dark:bg-white/[0.1] text-black dark:text-white";
const navInactive = "";

const homeHref = withBase(localePrefix || '/');
const articlesHref = withBase(`${localePrefix}/articles/`);
const activityHref = withBase(`${localePrefix}/activity/`);
const aboutHref = withBase(`${localePrefix}/about/`);
const groupsHref = withBase(`${localePrefix}/groups/`);
const linksHref = withBase(`${localePrefix}/links/`);

const isEn = currentLocale.toLowerCase() === 'en';
const targetLangHref = isEn
  ? withBase(pathNoLocale)
  : withBase(`/en${pathNoLocale}`);
---
<header
  class="site-header border-b border-black/[0.06] dark:border-white/[0.08] bg-white/75 dark:bg-[#161617]/75 backdrop-blur-xl sticky top-0 z-30 transition-all duration-300"
  transition:persist="site-header"
>
  <nav class="nav-main mx-auto max-w-6xl px-4 py-2.5 flex items-center gap-[var(--nav-inline-gap)]">
    <span class="nav-highlight" aria-hidden="true"></span>
    <a href={homeHref} class="inline-flex items-center gap-2 mr-2 group shrink-0" aria-label="SFA Home">
      <img src={withBase('/favicon.svg')} alt="SFA" class="w-6 h-6 rounded-md object-contain transition-transform group-hover:scale-105" />
    </a>
    <a href={homeHref} class={`${navBase} ${isHomeNormalized ? `${navActive} is-active` : ''}`}>{t('nav.home','首页')}</a>
    <a href={articlesHref} class={`${navBase} ${isSection('/articles/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/articles/') ? 'page' : undefined}>{t('nav.articles','文章')}</a>
    <a href={activityHref} class={`${navBase} ${isSection('/activity/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/activity/') ? 'page' : undefined}>{t('nav.activity','活动')}</a>
    <a href={aboutHref} class={`${navBase} ${isSection('/about/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/about/') ? 'page' : undefined}>{t('nav.about','关于我们')}</a>
    <a href={groupsHref} class={`${navBase} ${isSection('/groups/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/groups/') ? 'page' : undefined}>{t('nav.groups','兴趣小组')}</a>
    <a href={linksHref} class={`${navBase} ${isSection('/links/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/links/') ? 'page' : undefined}>{t('nav.links','友链')}</a>

    <div class="ml-auto flex items-center gap-2.5">
      <a
        id="lang-toggle"
        href={targetLangHref}
        class="group h-9 px-3 inline-flex items-center gap-1.5 rounded-full border border-black/[0.08] dark:border-white/[0.14] bg-white/70 dark:bg-white/[0.08] hover:bg-black/[0.04] dark:hover:bg-white/[0.14] transition-all duration-300 shadow-2xs hover:shadow-sm text-xs font-semibold text-slate-700 dark:text-slate-200"
        title={isEn ? "切换为中文 (Switch to Chinese)" : "Switch to English"}
        aria-label={isEn ? "切换为中文" : "Switch to English"}
      >
        <svg
          width="16"
          height="16"
          class="w-4 h-4 opacity-75 group-hover:opacity-100 transition-transform duration-300 group-hover:rotate-12 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          <path d="M2 12h20" />
        </svg>
        <span data-lang-label>{isEn ? "中" : "EN"}</span>
      </a>

      <button
        id="theme-toggle"
        class="group w-9 h-9 inline-flex items-center justify-center rounded-full border border-black/[0.08] dark:border-white/[0.14] bg-white/70 dark:bg-white/[0.08] hover:bg-black/[0.04] dark:hover:bg-white/[0.14] transition-all duration-300 shadow-2xs hover:shadow-sm"
        aria-pressed="false"
        title={t('actions.toggleTheme','切换主题')}
      >
        <span class="sr-only">切换主题</span>
        <svg
          width="18"
          height="18"
          class="w-[18px] h-[18px] text-amber-500 transition-transform duration-500 group-hover:rotate-45 block dark:hidden shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" fill="currentColor" fill-opacity="0.2" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg
          width="18"
          height="18"
          class="w-[18px] h-[18px] text-sky-300 transition-transform duration-500 group-hover:-rotate-12 hidden dark:block shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" fill="currentColor" fill-opacity="0.3" />
          <path d="M19 3v4" />
          <path d="M21 5h-4" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL || '/' }}>
  (function() {
    if (window.__sfa_header_init__) return;
    window.__sfa_header_init__ = true;

    var header = document.querySelector('.site-header');
    var nav = document.querySelector('.site-header .nav-main');
    var btn = document.getElementById('theme-toggle');
    if (!header || !nav) return;

    var links = Array.from(nav.querySelectorAll('.nav-link'));
    var hl = nav.querySelector('.nav-highlight');
    if (!hl) {
      hl = document.createElement('span');
      hl.className = 'nav-highlight';
      hl.setAttribute('aria-hidden', 'true');
      nav.prepend(hl);
    }
    nav.classList.add('has-navhl');

    var lastY = window.scrollY || 0;
    var ticking = false;

    function isMobile() {
      return window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
    }

    function normalizePath(p) {
      try { var u = new URL(p, window.location.origin); p = u.pathname; } catch(e){}
      p = p || '/';
      var cleanBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
      if (cleanBase !== '/' && p.indexOf(cleanBase) === 0) {
        p = '/' + p.slice(cleanBase.length);
      }
      p = p.replace(/^\/[a-z]{2}(?:-[a-z]{2})?(?=\/|$)/i, '') || '/';
      if (!p.endsWith('/')) p += '/';
      return p;
    }

    function rect(el) {
      var left = 0, width = 0;
      try { left = el.offsetLeft; width = el.offsetWidth; }
      catch(e) {
        var r = el.getBoundingClientRect();
        var n = nav.getBoundingClientRect();
        left = r.left - n.left + nav.scrollLeft;
        width = r.width;
      }
      return { left: left, width: width };
    }

    function moveTo(el) {
      if (!el) return;
      var nrect = nav.getBoundingClientRect();
      if (!nrect || nrect.width === 0 || nrect.height === 0) {
        requestAnimationFrame(function(){ moveTo(el); });
        return;
      }
      var m = rect(el);
      hl.style.setProperty('--hl-left', m.left + 'px');
      hl.style.setProperty('--hl-width', m.width + 'px');
      hl.style.opacity = '1';
    }

    function current() {
      return nav.querySelector('.nav-link.is-active') || links[0];
    }

    function recalc() {
      moveTo(current());
    }

    function scrollActiveIntoView(behavior) {
      if (!isMobile()) return;
      var a = current(); if (!a) return;
      var nrect = nav.getBoundingClientRect();
      if (!nrect || nrect.width === 0 || nrect.height === 0) return;
      var arect = a.getBoundingClientRect();
      var leftWithinNav = arect.left - nrect.left;
      var currentLeft = nav.scrollLeft + leftWithinNav;
      var target = currentLeft - (nrect.width - arect.width) / 2;
      var maxScroll = nav.scrollWidth - nav.clientWidth; if (maxScroll < 0) maxScroll = 0;
      var next = Math.max(0, Math.min(target, maxScroll));
      try { nav.scrollTo({ left: next, behavior: behavior || 'auto' }); }
      catch (e) { nav.scrollLeft = next; }
    }

    function setActiveByURL() {
      var cur = normalizePath(window.location.pathname);
      var best = { a: null, len: -1 };
      links.forEach(function(a){
        var href = a.getAttribute('href') || '/';
        var base = normalizePath(href);
        if (base === '/' && cur === '/') {
          if (base.length > best.len) best = { a: a, len: base.length }; return;
        }
        if (base !== '/' && cur.indexOf(base) === 0) {
          if (base.length > best.len) best = { a: a, len: base.length };
        }
      });
      links.forEach(function(a){ a.classList.remove('is-active'); a.removeAttribute('aria-current'); });
      if (best.a) { best.a.classList.add('is-active'); best.a.setAttribute('aria-current', 'page'); }
    }

    function updateLangToggle() {
      var lang = document.getElementById('lang-toggle');
      if (!lang) return;
      var curPath = window.location.pathname;
      var cleanBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
      var pathNoBase = (cleanBase !== '/' && curPath.indexOf(cleanBase) === 0)
        ? '/' + curPath.slice(cleanBase.length)
        : curPath;
      var isEn = /^\/en(?:\/|$)/i.test(pathNoBase);
      var pathNoLocale = pathNoBase.replace(/^\/[a-z]{2}(?:-[a-z]{2})?(?=\/|$)/i, '') || '/';
      if (!pathNoLocale.startsWith('/')) pathNoLocale = '/' + pathNoLocale;

      var targetPath = isEn ? pathNoLocale : ('/en' + (pathNoLocale === '/' ? '/' : pathNoLocale));
      var targetHref = (cleanBase !== '/' ? cleanBase.replace(/\/$/, '') : '') + targetPath;

      lang.setAttribute('href', targetHref);
      lang.setAttribute('title', isEn ? '切换为中文 (Switch to Chinese)' : 'Switch to English');
      lang.setAttribute('aria-label', isEn ? '切换为中文' : 'Switch to English');
      var labelEl = lang.querySelector('[data-lang-label]');
      if (labelEl) labelEl.textContent = isEn ? '中' : 'EN';
    }

    function setPressed() {
      var tBtn = document.getElementById('theme-toggle');
      if (!tBtn) return;
      var isDark = document.documentElement.classList.contains('dark');
      tBtn.setAttribute('aria-pressed', String(isDark));
    }

    if (btn) {
      btn.addEventListener('click', function() {
        var d = document.documentElement;
        var isDark = d.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
        setPressed();
      });
    }

    links.forEach(function(a) {
      a.addEventListener('mouseenter', function() { moveTo(a); });
      a.addEventListener('focus', function() { moveTo(a); });
    });
    nav.addEventListener('mouseleave', recalc);
    nav.addEventListener('scroll', recalc, { passive: true });
    window.addEventListener('resize', function(){ recalc(); scrollActiveIntoView('auto'); });
    window.addEventListener('popstate', function(){ setActiveByURL(); updateLangToggle(); recalc(); scrollActiveIntoView('smooth'); });

    try {
      var body = document.body;
      var mo = new MutationObserver(function(muts){
        for (var i=0;i<muts.length;i++) {
          var m = muts[i];
          if (m.attributeName === 'class' && !body.classList.contains('hide-header-footer')) {
            recalc(); scrollActiveIntoView('auto'); break;
          }
        }
      });
      mo.observe(body, { attributes: true, attributeFilter: ['class'] });
    } catch (e) {}

    try {
      if (document.fonts && document.fonts.ready) { document.fonts.ready.then(function(){ recalc(); }); }
      if (window.ResizeObserver) { var ro = new ResizeObserver(function(){ recalc(); }); ro.observe(nav); }
    } catch(e) {}

    function handleScroll() {
      var y = window.scrollY || 0;
      var dy = y - lastY;
      var atTop = y <= 8;
      if (atTop) {
        header.classList.remove('is-hidden');
      } else if (dy > 6) {
        header.classList.add('is-hidden');
      } else if (dy < -6) {
        header.classList.remove('is-hidden');
      }
      lastY = y;
    }
    window.addEventListener('scroll', function(){
      if (!ticking) { ticking = true; requestAnimationFrame(function(){ handleScroll(); ticking = false; }); }
    }, { passive: true });

    document.addEventListener('astro:page-load', function() {
      header.classList.remove('is-hidden');
      lastY = window.scrollY || 0;
      setActiveByURL();
      updateLangToggle();
      setPressed();
      recalc();
      scrollActiveIntoView('auto');
    });

    setActiveByURL();
    updateLangToggle();
    setPressed();
    recalc();
    scrollActiveIntoView('auto');
  })();
</script>
