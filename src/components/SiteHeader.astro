---
/**
 * SiteHeader
 * - 用途：站点顶部导航，含主题切换、当前项高亮与移动端滚动隐藏/显示。
 * - Props：
 *   - localePrefix：语言前缀（如 /zh-CN）
 *   - isHomeNormalized：是否为“首页”路径（已去除 locale 前缀并标准化）
 *   - pathNoLocale：去除 locale 前缀的路径（用于激活态判断）
 *   - t：i18n 翻译函数
 * - 交互：
 *   - 主题切换：切换 html.dark 并持久化到 localStorage。
 *   - 导航高亮：根据激活项移动滑块；窗口 resize/scroll/路由回退时复位。
 *   - 滚动行为：向下滚动隐藏 header，向上滚动或回到顶部显示。
 * - 无障碍：aria-current 标注当前页面；主题按钮使用 aria-pressed。
 */
interface Props {
  localePrefix: string;
  isHomeNormalized: boolean;
  pathNoLocale: string;
  t: (key: string, fallback?: string) => string;
}
const { localePrefix, isHomeNormalized, pathNoLocale, t } = Astro.props as Props;

const isSection = (prefix: string) => pathNoLocale === prefix || pathNoLocale.startsWith(prefix);
const navBase = "relative inline-flex items-center py-2 px-3 text-[13px] sm:text-sm font-medium tracking-tight rounded-full transition-colors nav-link text-slate-700 dark:text-slate-200 hover:text-black dark:hover:text-white";
const navActive = "bg-black/[0.05] dark:bg-white/[0.1] text-black dark:text-white";
const navInactive = "";
---
<header
  class="site-header border-b border-black/[0.06] dark:border-white/[0.08] bg-white/75 dark:bg-[#161617]/75 backdrop-blur-xl sticky top-0 z-30 transition-all duration-300"
>
  <nav class="nav-main mx-auto max-w-6xl px-4 py-2.5 flex items-center gap-[var(--nav-inline-gap)]">
    <span class="nav-highlight" aria-hidden="true"></span>
    <a href={localePrefix || '/'} class="inline-flex items-center gap-2 mr-2 group shrink-0" aria-label="SFA Home">
      <img src="/favicon.svg" alt="SFA" class="w-6 h-6 rounded-md object-contain transition-transform group-hover:scale-105" />
    </a>
    <a href={localePrefix || '/'} class={`${navBase} ${isHomeNormalized ? `${navActive} is-active` : ''}`}>{t('nav.home','首页')}</a>
    <a href={`${localePrefix}/articles/`} class={`${navBase} ${isSection('/articles/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/articles/') ? 'page' : undefined}>{t('nav.articles','文章')}</a>
    <a href={`${localePrefix}/activity/`} class={`${navBase} ${isSection('/activity/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/activity/') ? 'page' : undefined}>{t('nav.activity','活动')}</a>
    <a href={`${localePrefix}/about/`} class={`${navBase} ${isSection('/about/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/about/') ? 'page' : undefined}>{t('nav.about','关于我们')}</a>
    <a href={`${localePrefix}/groups/`} class={`${navBase} ${isSection('/groups/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/groups/') ? 'page' : undefined}>{t('nav.groups','兴趣小组')}</a>
    <a href={`${localePrefix}/links/`} class={`${navBase} ${isSection('/links/') ? `${navActive} is-active` : navInactive}`} aria-current={isSection('/links/') ? 'page' : undefined}>{t('nav.links','友链')}</a>
    <div class="ml-auto flex items-center gap-3">
      <button id="theme-toggle" class="w-9 h-9 inline-flex items-center justify-center rounded-full border border-black/[0.08] dark:border-white/[0.12] bg-white/60 dark:bg-white/[0.06] hover:bg-black/[0.04] dark:hover:bg-white/[0.12] transition-colors text-slate-700 dark:text-slate-200 shadow-2xs" aria-pressed="false" title={t('actions.toggleTheme','切换主题')}>
        <span class="sr-only">切换主题</span>
        <!-- 太阳图标（亮） -->
        <svg class="w-4.5 h-4.5 dark:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 4.5a1 1 0 0 1 1 1V7a1 1 0 1 1-2 0V5.5a1 1 0 0 1 1-1Zm0 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.5-4a1 1 0 0 1 1 1v.01a1 1 0 1 1-2 0V12.5a1 1 0 0 1 1-1ZM12 17a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V18a1 1 0 0 1 1-1ZM4.5 11.5a1 1 0 0 1 1 1v.01a1 1 0 1 1-2 0V12.5a1 1 0 0 1 1-1ZM6.34 6.34a1 1 0 0 1 1.41 0l1.06 1.06a1 1 0 1 1-1.41 1.41L6.34 7.75a1 1 0 0 1 0-1.41Zm9.85 9.85a1 1 0 0 1 1.41 0l1.06 1.06a1 1 0 0 1-1.41 1.41l-1.06-1.06a1 1 0 0 1 0-1.41ZM17.66 6.34a1 1 0 0 1 0 1.41l-1.06 1.06a1 1 0 1 1-1.41-1.41l1.06-1.06a1 1 0 0 1 1.41 0ZM7.75 16.19a1 1 0 0 1 0 1.41L6.69 18.66a1 1 0 1 1-1.41-1.41l1.06-1.06a1 1 0 0 1 1.41 0Z"/>
        </svg>
        <!-- 月亮图标（暗） -->
        <svg class="w-4.5 h-4.5 hidden dark:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  // 主题切换按钮逻辑：在 html 上切换 .dark，并持久化到 localStorage
  (function() {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var setPressed = function() {
      var isDark = document.documentElement.classList.contains('dark');
      btn.setAttribute('aria-pressed', String(isDark));
    };
    setPressed();
    btn.addEventListener('click', function() {
      var d = document.documentElement;
      var isDark = d.classList.toggle('dark');
      try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
      setPressed();
    });
  })();

  // 导航滑动高亮初始化与交互
  (function() {
    var nav = document.querySelector('.site-header .nav-main');
    if (!nav) return;
    var links = Array.from(nav.querySelectorAll('.nav-link'));
    if (!links.length) return;
    var hl = nav.querySelector('.nav-highlight');
    if (!hl) {
      hl = document.createElement('span');
      hl.className = 'nav-highlight';
      hl.setAttribute('aria-hidden', 'true');
      nav.prepend(hl);
    }
    nav.classList.add('has-navhl');

    function rect(el) {
      var left = 0, width = 0;
      try { left = el.offsetLeft; width = el.offsetWidth; }
      catch(e) {
        var r = el.getBoundingClientRect();
        var n = nav.getBoundingClientRect();
        left = r.left - n.left + nav.scrollLeft;
        width = r.width;
      }
      return { left: left, width: width };
    }
    function moveTo(el) {
      if (!el) return;
      var nrect = nav.getBoundingClientRect();
      if (!nrect || nrect.width === 0 || nrect.height === 0) {
        requestAnimationFrame(function(){ moveTo(el); });
        return;
      }
      var m = rect(el);
      hl.style.setProperty('--hl-left', m.left + 'px');
      hl.style.setProperty('--hl-width', m.width + 'px');
      hl.style.opacity = '1';
    }
    function current() {
      return nav.querySelector('.nav-link.is-active') || links[0];
    }
    function isMobile() {
      return window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
    }
    function normalizePath(p){
      try { var u = new URL(p, window.location.origin); p = u.pathname; } catch(e){}
      p = p || '/';
      p = p.replace(/^\/[a-z]{2}(?:-[a-z]{2})?(?=\/|$)/i, '') || '/';
      if (!p.endsWith('/')) p += '/';
      return p;
    }
    function setActiveByURL(){
      var cur = normalizePath(window.location.pathname);
      var best = { a: null, len: -1 };
      links.forEach(function(a){
        var href = a.getAttribute('href') || '/';
        var base = normalizePath(href);
        if (base === '/' && cur === '/') {
          if (base.length > best.len) best = { a: a, len: base.length }; return;
        }
        if (base !== '/' && cur.indexOf(base) === 0) {
          if (base.length > best.len) best = { a: a, len: base.length };
        }
      });
      links.forEach(function(a){ a.classList.remove('is-active'); a.removeAttribute('aria-current'); });
      if (best.a) { best.a.classList.add('is-active'); best.a.setAttribute('aria-current', 'page'); }
    }
    function scrollActiveIntoView(behavior) {
      if (!isMobile()) return;
      var a = current(); if (!a) return;
      var nrect = nav.getBoundingClientRect();
      if (!nrect || nrect.width === 0 || nrect.height === 0) return;
      var arect = a.getBoundingClientRect();
      var leftWithinNav = arect.left - nrect.left;
      var currentLeft = nav.scrollLeft + leftWithinNav;
      var target = currentLeft - (nrect.width - arect.width) / 2;
      var maxScroll = nav.scrollWidth - nav.clientWidth; if (maxScroll < 0) maxScroll = 0;
      var next = Math.max(0, Math.min(target, maxScroll));
      try { nav.scrollTo({ left: next, behavior: behavior || 'auto' }); }
      catch (e) { nav.scrollLeft = next; }
    }
    function recalc() { moveTo(current()); }
    setActiveByURL();
    scrollActiveIntoView('auto');
    recalc();
    window.addEventListener('resize', function(){ recalc(); scrollActiveIntoView('auto'); });
    nav.addEventListener('scroll', recalc, { passive: true });
    window.addEventListener('popstate', function(){ setActiveByURL(); recalc(); scrollActiveIntoView('smooth'); });
    links.forEach(function(a) {
      a.addEventListener('mouseenter', function() { moveTo(a); });
      a.addEventListener('focus', function() { moveTo(a); });
    });
    nav.addEventListener('mouseleave', recalc);
    try {
      var body = document.body;
      var mo = new MutationObserver(function(muts){
        for (var i=0;i<muts.length;i++) {
          var m = muts[i];
          if (m.attributeName === 'class' && !body.classList.contains('hide-header-footer')) {
            recalc(); scrollActiveIntoView('auto'); break;
          }
        }
      });
      mo.observe(body, { attributes: true, attributeFilter: ['class'] });
    } catch (e) {}
    try {
      if (document.fonts && document.fonts.ready) { document.fonts.ready.then(function(){ recalc(); }); }
      if (window.ResizeObserver) { var ro = new ResizeObserver(function(){ recalc(); }); ro.observe(nav); }
    } catch(e) {}
  })();

  // 页面滚动时：下滑隐藏 Header，上滑显示；在顶部时始终显示
  (function(){
    var header = document.querySelector('.site-header');
    if (!header) return;
    var lastY = window.scrollY || 0;
    var ticking = false;
    function handle() {
      var y = window.scrollY || 0;
      var dy = y - lastY;
      var atTop = y <= 8;
      if (atTop) {
        header.classList.remove('is-hidden');
      } else if (dy > 6) {
        header.classList.add('is-hidden');
      } else if (dy < -6) {
        header.classList.remove('is-hidden');
      }
      lastY = y;
    }
    window.addEventListener('scroll', function(){
      if (!ticking) { ticking = true; requestAnimationFrame(function(){ handle(); ticking = false; }); }
    }, { passive: true });
  })();
</script>
