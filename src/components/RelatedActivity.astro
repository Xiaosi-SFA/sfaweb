---
/**
 * RelatedActivity
 * - 用途：基于标签重叠度与时间新近度推荐相关活动。
 * - 样式：与侧边栏与正文完全对齐的沉静半透明卡片。
 */
import { getCollection } from "astro:content";
import { withBase } from "@utils/path";

interface Props {
  currentSlug: string;
  tags?: string[];
  limit?: number;
}
const { currentSlug, tags = [], limit = 3 } = Astro.props as Props;

const all = await (getCollection as any)("activity");
const scored = all
  .filter((e: any) => e.slug !== currentSlug)
  .map((e: any) => {
    const overlap = (e.data.tags || []).filter((t: string) =>
      tags.includes(t),
    ).length;
    return { e, score: overlap };
  })
  .sort((a: any, b: any) => {
    if (b.score !== a.score) return b.score - a.score;
    const ad = a.e.data.date?.valueOf() ?? 0;
    const bd = b.e.data.date?.valueOf() ?? 0;
    return bd - ad;
  })
  .slice(0, limit);
---
{scored.length ? (
  <aside class="bg-white/80 dark:bg-[#2c2c2e]/70 backdrop-blur supports-[backdrop-filter]:bg-white/60 supports-[backdrop-filter]:dark:bg-[#2c2c2e]/60 border border-black/[0.06] dark:border-[#2c2c2e] rounded-2xl p-5 shadow-xs">
    <div class="text-sm font-bold mb-3 text-slate-900 dark:text-slate-100 tracking-tight">相关活动</div>
    <ul class="space-y-3">
      {scored.map(({ e }: { e: any }) => (
        <li>
          <a href={withBase(`/activity/${e.slug}/`)} class="group block space-y-0.5">
            <div class="text-xs font-medium text-slate-400 dark:text-slate-500">
              {e.data.date?.toISOString().slice(0, 10)}
            </div>
            <div class="text-sm font-semibold text-slate-700 dark:text-slate-200 group-hover:text-sky-600 dark:group-hover:text-sky-300 transition-colors line-clamp-1">
              {e.data.title}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </aside>
) : null}
