---
import '@styles/wave.css'
---
<div class="wave-bg" transition:persist="wave-bg" aria-hidden="true">
  <canvas id="mygoSineCanvas" class="sine-canvas"></canvas>
</div>

<script is:inline>
  (function () {
    if (window.__sfa_wave_init__) return;
    window.__sfa_wave_init__ = true;

    const canvas = document.getElementById('mygoSineCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    // Light mode palette
    const MYGO_PALETTE = [
      { name: 'Tomori', color: 'rgba(119, 187, 221, 0.95)', glow: 'rgba(119, 187, 221, 0.45)', hex: '#77BBDD' },
      { name: 'Anon',   color: 'rgba(255, 136, 153, 0.90)', glow: 'rgba(255, 136, 153, 0.40)', hex: '#FF8899' },
      { name: 'Rana',   color: 'rgba(119, 221, 119, 0.90)', glow: 'rgba(119, 221, 119, 0.40)', hex: '#77DD77' },
      { name: 'Soyo',   color: 'rgba(255, 221, 136, 0.92)', glow: 'rgba(255, 221, 136, 0.42)', hex: '#FFDD88' },
      { name: 'Taki',   color: 'rgba(119, 119, 170, 0.90)', glow: 'rgba(119, 119, 170, 0.40)', hex: '#7777AA' },
    ];

    // Dark mode palette
    const MUJICA_PALETTE = [
      { name: 'Oblivionis', color: 'rgba(119, 153, 204, 0.95)', glow: 'rgba(119, 153, 204, 0.55)', hex: '#7799CC' },
      { name: 'Doloris',    color: 'rgba(187, 153, 85, 0.95)',  glow: 'rgba(187, 153, 85, 0.55)',  hex: '#BB9955' },
      { name: 'Mortis',     color: 'rgba(119, 153, 119, 0.90)', glow: 'rgba(119, 153, 119, 0.45)', hex: '#779977' },
      { name: 'Timoris',    color: 'rgba(75, 120, 160, 0.92)',  glow: 'rgba(75, 120, 160, 0.45)',  hex: '#4B78A0' },
      { name: 'Amoris',     color: 'rgba(170, 68, 119, 0.95)',  glow: 'rgba(170, 68, 119, 0.55)',  hex: '#AA4477' },
    ];

    function generateRandomWaveParams() {
      const count = 5;
      const params = [];
      for (let i = 0; i < count; i++) {
        const ampRatio = 0.055 + Math.random() * 0.040;
        const freq1 = 0.0012 + Math.random() * 0.0016;
        const freq2 = freq1 * (1.6 + Math.random() * 0.8);
        const speed1 = (0.00035 + Math.random() * 0.00030) * (i % 2 === 0 ? 1 : -1);
        const speed2 = (0.00028 + Math.random() * 0.00030) * (i % 2 === 0 ? -1 : 1);
        const phase = (i * (Math.PI * 2 / count)) + (Math.random() * 0.8 - 0.4);
        const lineWidth = 1.25 + Math.random() * 0.25;
        const breatheSpeed = 0.00025 + Math.random() * 0.00025;
        const breathePhase = Math.random() * Math.PI * 2;

        params.push({
          ampRatio,
          freq1,
          freq2,
          speed1,
          speed2,
          phase,
          lineWidth,
          breatheSpeed,
          breathePhase,
        });
      }
      return params;
    }

    const WAVES = generateRandomWaveParams();

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let time = 0;

    function isDarkMode() {
      return document.documentElement.classList.contains('dark');
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    // 汉宁窗包络函数
    function envelope(x, w) {
      if (w <= 0) return 0;
      const nx = x / w;
      const s = Math.sin(Math.PI * nx);
      return Math.pow(s, 2.2);
    }

    function render(timestamp) {
      time = timestamp || performance.now();
      ctx.clearRect(0, 0, width, height);

      const dark = isDarkMode();
      const palette = dark ? MUJICA_PALETTE : MYGO_PALETTE;
      const centerY = height * 0.50;

      ctx.beginPath();
      ctx.strokeStyle = dark ? 'rgba(119, 153, 204, 0.15)' : 'rgba(119, 187, 221, 0.20)';
      ctx.lineWidth = 0.8;
      ctx.moveTo(0, centerY);
      ctx.lineTo(width, centerY);
      ctx.stroke();

      const step = Math.max(3, Math.floor(width / 220));

      for (let i = 0; i < WAVES.length; i++) {
        const w = WAVES[i];
        const p = palette[i % palette.length];

        const breathe = 1.0 + 0.10 * Math.sin(time * w.breatheSpeed + w.breathePhase);
        const amp = height * w.ampRatio * breathe;

        ctx.save();
        ctx.beginPath();
        ctx.lineWidth = w.lineWidth;
        ctx.strokeStyle = p.color;
        ctx.shadowColor = p.glow;
        ctx.shadowBlur = dark ? 8 : 5;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        let started = false;

        for (let x = 0; x <= width; x += step) {
          const env = envelope(x, width);
          const wave1 = Math.sin(x * w.freq1 + time * w.speed1 + w.phase);
          const wave2 = Math.sin(x * w.freq2 + time * w.speed2 + w.phase * 1.5) * 0.30;
          const y = centerY + (wave1 + wave2) * amp * env;

          if (!started) {
            ctx.moveTo(x, y);
            started = true;
          } else {
            ctx.lineTo(x, y);
          }
        }

        if (started) {
          ctx.lineTo(width, centerY);
        }

        ctx.stroke();
        ctx.restore();
      }

      if (!document.hidden) {
        animId = requestAnimationFrame(render);
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        cancelAnimationFrame(animId);
        animId = requestAnimationFrame(render);
      } else {
        cancelAnimationFrame(animId);
      }
    });

    animId = requestAnimationFrame(render);
  })();
</script>
