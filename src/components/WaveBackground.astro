---
/**
 * WaveBackground
 * - 用途：《迷星叫》PV 风格的正弦波流动背景（Sine Waveform Envelope）。
 * - 视觉参数调优：
 *   - 振幅尺度：居中占据屏幕纵向约 20% 空间，轻盈空灵不喧宾夺主。
 *   - 慢速流动：沉静悠扬的极缓呼吸感。
 *   - 纤细色带：1.2px ~ 1.5px 极细高清光丝线条。
 *   - 随机性：在指定美学范围内为各角色颜色分配随机的振幅、基频、副波比、初始相位与呼吸微扰。
 *   - 浅色模式（Light）：MyGO!!!!! 5人代表色（灯·水天蓝 / 爱音·樱粉 / 乐奈·薄荷绿 / 爽世·琥珀金 / 立希·幽暮紫）。
 *   - 暗色模式（Dark）：Ave Mujica 5人代表色（祥子·苍夜冰蓝 / 初华·冷月白银 / 睦·幽森绿 / 海铃·暮霭群青 / 若麦·瑰丽金）。
 */
import '@styles/wave.css'
---
<div class="wave-bg" aria-hidden="true">
  <!-- 环境流光层 -->
  <div class="liquid-ambient-container">
    <div class="liquid-orb liquid-orb-1"></div>
    <div class="liquid-orb liquid-orb-2"></div>
    <div class="liquid-orb liquid-orb-3"></div>
  </div>

  <!-- 迷星叫正弦波 Canvas 渲染层 -->
  <canvas id="mygoSineCanvas" class="sine-canvas"></canvas>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('mygoSineCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    // 配色定义
    // MyGO!!!!! 配色 (Light Mode: 细线高饱和通透)
    const MYGO_PALETTE = [
      { name: 'Tomori', color: 'rgba(24, 160, 251, 0.95)', glow: 'rgba(24, 160, 251, 0.40)' }, // 高松灯 - 水天蓝
      { name: 'Anon',   color: 'rgba(250, 93, 131, 0.90)', glow: 'rgba(250, 93, 131, 0.35)' }, // 千早爱音 - 樱粉
      { name: 'Rana',   color: 'rgba(16, 185, 129, 0.90)', glow: 'rgba(16, 185, 129, 0.35)' }, // 要乐奈 - 薄荷绿
      { name: 'Soyo',   color: 'rgba(245, 158, 11, 0.92)', glow: 'rgba(245, 158, 11, 0.38)' }, // 长崎爽世 - 琥珀金
      { name: 'Taki',   color: 'rgba(139, 92, 246, 0.90)', glow: 'rgba(139, 92, 246, 0.35)' }, // 椎名立希 - 幽暮紫
    ];

    // Ave Mujica 配色 (Dark Mode: 星夜荧光)
    const MUJICA_PALETTE = [
      { name: 'Oblivionis', color: 'rgba(96, 165, 250, 0.95)', glow: 'rgba(96, 165, 250, 0.50)' }, // 丰川祥子 - 苍夜冰蓝
      { name: 'Doloris',    color: 'rgba(255, 255, 255, 0.98)', glow: 'rgba(255, 255, 255, 0.60)' }, // 三角初华 - 冷月白银
      { name: 'Mortis',     color: 'rgba(52, 211, 153, 0.90)', glow: 'rgba(52, 211, 153, 0.45)' }, // 若叶睦 - 幽森翠绿
      { name: 'Timoris',    color: 'rgba(129, 140, 248, 0.92)', glow: 'rgba(129, 140, 248, 0.45)' }, // 八幡海铃 - 暮霭群青
      { name: 'Amoris',     color: 'rgba(251, 191, 36, 0.95)', glow: 'rgba(251, 191, 36, 0.50)' }, // 祐天寺若麦 - 瑰丽金
    ];

    // 在指定美学范围内为 5 种角色颜色分配随机的振幅、频率与流速
    function generateRandomWaveParams() {
      const count = 5;
      const params = [];
      for (let i = 0; i < count; i++) {
        // 振幅单边比例控制在 0.055 ~ 0.095（总峰峰值跨度严格控制在屏幕的 15% ~ 20%）
        const ampRatio = 0.055 + Math.random() * 0.040;
        // 基频在 0.0012 ~ 0.0028 之间随机分布，波浪舒展自然
        const freq1 = 0.0012 + Math.random() * 0.0016;
        const freq2 = freq1 * (1.6 + Math.random() * 0.8);
        // 速度大幅调慢：0.00035 ~ 0.00065，沉静从容
        const speed1 = (0.00035 + Math.random() * 0.00030) * (i % 2 === 0 ? 1 : -1);
        const speed2 = (0.00028 + Math.random() * 0.00030) * (i % 2 === 0 ? -1 : 1);
        const phase = (i * (Math.PI * 2 / count)) + (Math.random() * 0.8 - 0.4);
        // 纤细精致线宽：1.2px ~ 1.5px
        const lineWidth = 1.25 + Math.random() * 0.25;
        // 振幅缓慢呼吸微调周期
        const breatheSpeed = 0.00025 + Math.random() * 0.00025;
        const breathePhase = Math.random() * Math.PI * 2;

        params.push({
          ampRatio,
          freq1,
          freq2,
          speed1,
          speed2,
          phase,
          lineWidth,
          breatheSpeed,
          breathePhase,
        });
      }
      return params;
    }

    const WAVES = generateRandomWaveParams();

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let time = 0;

    function isDarkMode() {
      return document.documentElement.classList.contains('dark');
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    // 汉宁平滑包络函数：两端平滑归零，中央占据 20% 空间隆起
    function envelope(x, w) {
      if (w <= 0) return 0;
      const nx = x / w; // [0, 1]
      const s = Math.sin(Math.PI * nx);
      return Math.pow(s, 2.2); // 保持中间适度舒展，两端自然收拢为水平线
    }

    function render(timestamp) {
      time = timestamp || performance.now();
      ctx.clearRect(0, 0, width, height);

      const dark = isDarkMode();
      const palette = dark ? MUJICA_PALETTE : MYGO_PALETTE;
      const centerY = height * 0.50; // 居中水平基准线

      // 1. 绘制水平中央基准延伸微光线（细致轻柔）
      ctx.beginPath();
      ctx.strokeStyle = dark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(24, 160, 251, 0.16)';
      ctx.lineWidth = 0.8;
      ctx.moveTo(0, centerY);
      ctx.lineTo(width, centerY);
      ctx.stroke();

      // 2. 绘制 5 条正弦波
      const step = Math.max(3, Math.floor(width / 220));

      for (let i = 0; i < WAVES.length; i++) {
        const w = WAVES[i];
        const p = palette[i % palette.length];

        // 呼吸微调：振幅在自身基准上随时间产生 ±10% 的自然呼吸起伏
        const breathe = 1.0 + 0.10 * Math.sin(time * w.breatheSpeed + w.breathePhase);
        // 单边振幅最大为 height * w.ampRatio * breathe（总波峰波谷严格在屏幕中间 20% 范围）
        const amp = height * w.ampRatio * breathe;

        ctx.save();
        ctx.beginPath();
        ctx.lineWidth = w.lineWidth;
        ctx.strokeStyle = p.color;
        ctx.shadowColor = p.glow;
        ctx.shadowBlur = dark ? 8 : 4;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        let started = false;

        for (let x = 0; x <= width; x += step) {
          const env = envelope(x, width);
          // 复合双频正弦波 + 慢速相位流动
          const wave1 = Math.sin(x * w.freq1 + time * w.speed1 + w.phase);
          const wave2 = Math.sin(x * w.freq2 + time * w.speed2 + w.phase * 1.5) * 0.30;
          const y = centerY + (wave1 + wave2) * amp * env;

          if (!started) {
            ctx.moveTo(x, y);
            started = true;
          } else {
            ctx.lineTo(x, y);
          }
        }

        if (started) {
          ctx.lineTo(width, centerY);
        }

        ctx.stroke();
        ctx.restore();
      }

      if (!document.hidden) {
        animId = requestAnimationFrame(render);
      }
    }

    // 页面切入后台时节能暂停
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        cancelAnimationFrame(animId);
        animId = requestAnimationFrame(render);
      } else {
        cancelAnimationFrame(animId);
      }
    });

    animId = requestAnimationFrame(render);
  })();
</script>
