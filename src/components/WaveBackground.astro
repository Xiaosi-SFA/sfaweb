---
/**
 * WaveBackground
 * - 用途：《迷星叫》PV 风格的正弦波流动背景（Sine Waveform Envelope）。
 * - 视觉设计：
 *   - 5 条交织流动的正弦波束，两侧平滑收敛为一条优雅水平线，中间起伏交织流动。
 *   - 浅色模式（Light）：MyGO!!!!! 5人代表色（灯·水天蓝 / 爱音·樱粉 / 乐奈·薄荷绿 / 爽世·琥珀金 / 立希·幽暮紫）。
 *   - 暗色模式（Dark）：Ave Mujica 5人代表色（祥子·苍夜冰蓝 / 初华·冷月白银 / 睦·幽森绿 / 海铃·暮霭群青 / 若麦·瑰丽金）。
 * - 性能：基于 HTML5 Canvas 绘制，自动监听系统/页面主题切换与屏幕 Resize，无卡顿 60FPS。
 */
import '@styles/wave.css'
---
<div class="wave-bg" aria-hidden="true">
  <!-- 环境流光层 -->
  <div class="liquid-ambient-container">
    <div class="liquid-orb liquid-orb-1"></div>
    <div class="liquid-orb liquid-orb-2"></div>
    <div class="liquid-orb liquid-orb-3"></div>
  </div>

  <!-- 迷星叫正弦波 Canvas 渲染层 -->
  <canvas id="mygoSineCanvas" class="sine-canvas"></canvas>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('mygoSineCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    // 配色定义
    // MyGO!!!!! 配色 (Light Mode: 鲜明通透，对比度充足)
    const MYGO_PALETTE = [
      { name: 'Tomori', color: 'rgba(24, 160, 251, 0.95)', glow: 'rgba(24, 160, 251, 0.50)', width: 2.8 }, // 高松灯 - 水天蓝 (主波，最清晰)
      { name: 'Anon',   color: 'rgba(250, 93, 131, 0.90)', glow: 'rgba(250, 93, 131, 0.40)', width: 2.2 }, // 千早爱音 - 樱粉
      { name: 'Rana',   color: 'rgba(16, 185, 129, 0.88)', glow: 'rgba(16, 185, 129, 0.40)', width: 2.2 }, // 要乐奈 - 薄荷绿
      { name: 'Soyo',   color: 'rgba(245, 158, 11, 0.92)', glow: 'rgba(245, 158, 11, 0.45)', width: 2.3 }, // 长崎爽世 - 琥珀暖金
      { name: 'Taki',   color: 'rgba(139, 92, 246, 0.88)', glow: 'rgba(139, 92, 246, 0.40)', width: 2.2 }, // 椎名立希 - 幽暮紫
    ];

    // Ave Mujica 配色 (Dark Mode: 夜色星芒荧光)
    const MUJICA_PALETTE = [
      { name: 'Oblivionis', color: 'rgba(96, 165, 250, 0.95)', glow: 'rgba(96, 165, 250, 0.60)', width: 2.8 }, // 丰川祥子 - 苍夜冰蓝
      { name: 'Doloris',    color: 'rgba(255, 255, 255, 0.98)', glow: 'rgba(255, 255, 255, 0.70)', width: 2.4 }, // 三角初华 - 冷月白银
      { name: 'Mortis',     color: 'rgba(52, 211, 153, 0.90)', glow: 'rgba(52, 211, 153, 0.50)', width: 2.2 }, // 若叶睦 - 幽森翠绿
      { name: 'Timoris',    color: 'rgba(129, 140, 248, 0.92)', glow: 'rgba(129, 140, 248, 0.50)', width: 2.2 }, // 八幡海铃 - 暮霭群青
      { name: 'Amoris',     color: 'rgba(251, 191, 36, 0.95)', glow: 'rgba(251, 191, 36, 0.55)', width: 2.3 }, // 祐天寺若麦 - 瑰丽金
    ];

    // 5 条波束的波动特征参数（频率、相位、流动速度、振幅比例）
    const WAVES = [
      { ampRatio: 0.15, freq1: 0.0016, freq2: 0.0032, speed1: 0.0015, speed2: -0.0020, phase: 0 },
      { ampRatio: 0.11, freq1: 0.0020, freq2: 0.0040, speed1: -0.0013, speed2: 0.0018, phase: 1.25 },
      { ampRatio: 0.09, freq1: 0.0024, freq2: 0.0048, speed1: 0.0017, speed2: -0.0015, phase: 2.50 },
      { ampRatio: 0.10, freq1: 0.0018, freq2: 0.0036, speed1: -0.0018, speed2: 0.0014, phase: 3.75 },
      { ampRatio: 0.08, freq1: 0.0022, freq2: 0.0044, speed1: 0.0014, speed2: -0.0022, phase: 5.00 },
    ];

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let time = 0;

    function isDarkMode() {
      return document.documentElement.classList.contains('dark');
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    // 汉宁窗包络函数：两端平滑收敛为 0，中央隆起
    function envelope(x, w) {
      if (w <= 0) return 0;
      const nx = x / w; // [0, 1]
      const s = Math.sin(Math.PI * nx);
      return s * s * s; // 三次方强化中央波形起伏，两端保持水平延展
    }

    function render(timestamp) {
      time = timestamp || performance.now();
      ctx.clearRect(0, 0, width, height);

      const dark = isDarkMode();
      const palette = dark ? MUJICA_PALETTE : MYGO_PALETTE;
      const centerY = height * 0.50; // 居中水平基准线
      const maxBaseAmp = Math.min(height * 0.48, 220);

      // 1. 绘制水平中央基准延伸微光线（两侧水平基线）
      ctx.beginPath();
      ctx.strokeStyle = dark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(24, 160, 251, 0.22)';
      ctx.lineWidth = 1;
      ctx.moveTo(0, centerY);
      ctx.lineTo(width, centerY);
      ctx.stroke();

      // 2. 绘制 5 条正弦波
      const step = Math.max(3, Math.floor(width / 200));

      for (let i = 0; i < WAVES.length; i++) {
        const w = WAVES[i];
        const p = palette[i % palette.length];
        const amp = maxBaseAmp * w.ampRatio;

        ctx.save();
        ctx.beginPath();
        ctx.lineWidth = p.width;
        ctx.strokeStyle = p.color;
        ctx.shadowColor = p.glow;
        ctx.shadowBlur = dark ? 12 : 6;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        let started = false;

        for (let x = 0; x <= width; x += step) {
          const env = envelope(x, width);
          // 复合双正弦波 + 相位演进
          const wave1 = Math.sin(x * w.freq1 + time * w.speed1 + w.phase);
          const wave2 = Math.sin(x * w.freq2 + time * w.speed2 + w.phase * 1.5) * 0.35;
          const y = centerY + (wave1 + wave2) * amp * env;

          if (!started) {
            ctx.moveTo(x, y);
            started = true;
          } else {
            ctx.lineTo(x, y);
          }
        }

        if (started) {
          ctx.lineTo(width, centerY);
        }

        ctx.stroke();
        ctx.restore();
      }

      if (!document.hidden) {
        animId = requestAnimationFrame(render);
      }
    }

    // 页面切入后台时节能暂停
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        cancelAnimationFrame(animId);
        animId = requestAnimationFrame(render);
      } else {
        cancelAnimationFrame(animId);
      }
    });

    animId = requestAnimationFrame(render);
  })();
</script>
