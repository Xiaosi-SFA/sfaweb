---
interface Props {
  href: string
  title: string
  date?: Date
  cover?: string
  tags?: string[]
  summary?: string
}
const { href, title, date, cover, tags = [], summary } = Astro.props as Props
---
<article class="bg-white rounded-macos overflow-hidden shadow-sm border hover:shadow-md transition-shadow">
  <a href={href} class="block">
    <div style="aspect-ratio:16/9; width:100%;" class="w-full bg-slate-100 rounded-macos overflow-hidden" data-card-cover>
      {cover ? (
        <img src={cover} alt={title} class="w-full h-full object-cover" />
      ) : (
        <img src="/logo-placeholder.svg" alt="placeholder" class="w-full h-full object-cover opacity-70" />
      )}
    </div>
    <div class="p-4">
      <div class="text-sm text-slate-500">
        {date ? new Date(date).toISOString().slice(0,10) : ''}
      </div>
      <h3 class="text-lg font-semibold mt-1">{title}</h3>
      {summary && <p class="text-slate-700 mt-1 line-clamp-2">{summary}</p>}
      {tags?.length ? (
        <div class="mt-2 flex gap-2 flex-wrap">
          {tags.map((t) => (
            <span class="text-xs px-2 py-0.5 bg-slate-100 rounded">{t}</span>
          ))}
        </div>
      ) : null}
    </div>
  </a>
  
  <style>
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; 
      overflow: hidden;
    }
  </style>
</article>
