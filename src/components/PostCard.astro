---
/**
 * PostCard
 * - 用途：文章卡片，包含封面、日期、标题、摘要与标签。
 * - 交互：hover 阴影；图片加载失败回退。
 * - 无障碍：封面 alt=标题；日期文字化显示。
 */
interface Props {
  /** 详情页链接 */
  href: string
  /** 标题 */
  title: string
  /** 日期（可选） */
  date?: Date
  /** 封面 URL（可选） */
  cover?: string
  /** 标签（可选） */
  tags?: string[]
  /** 摘要（可选） */
  summary?: string
}
const { href, title, date, cover, tags = [], summary } = Astro.props as Props
import '@styles/tag.css'
import '@styles/card.css'
---
<article class="card bg-white/90 dark:bg-[#2c2c2e]/60 shadow-sm hover:shadow-md transition-shadow">
  <div style="aspect-ratio:16/9; width:100%;" class="card-cover bg-slate-100 dark:bg-[#2c2c2e]" data-card-cover>
    <a href={href} aria-label={title} class="block">
      <img
        src={cover ?? '/back.png'}
        alt={title}
        class="w-full h-full object-cover"
        onerror="this.onerror=null;this.src='/back.png'"
      />
    </a>
  </div>
  <div class="card-content p-4">
      <div class="text-sm text-slate-500 dark:text-slate-400">
        {date ? new Date(date).toISOString().slice(0,10) : ''}
      </div>
      <h3 class="text-lg font-semibold mt-1 card-title">
        <a href={href} class="text-slate-900 dark:text-slate-100">{title}</a>
      </h3>
      {summary && <p class="text-slate-700 dark:text-slate-200 mt-1 line-clamp-2">{summary}</p>}
      {tags?.length ? (
        <div class="mt-2 tag-list tag-list--right">
          {tags.map((t) => (
            <a href={`/tags/${encodeURIComponent(t)}/`} class="tag tag--card">#{t}</a>
          ))}
        </div>
      ) : null}
  </div>
  
</article>
