---
interface Props {
  title: string
  description?: string
  link?: string
  linkLabel?: string
}

const { title, description, link, linkLabel = '查看全部' } = Astro.props as Props
---
<div class="section-header">
  <div class="section-header__text">
    <h2 class="section-header__title">{title}</h2>
    {description ? (<p class="section-header__desc">{description}</p>) : null}
  </div>
  {link ? (
    <a href={link} class="section-header__link link-apple">
      {linkLabel}
      <span class="chevron" aria-hidden>›</span>
    </a>
  ) : null}
</div>

<style>
  .section-header { display: flex; flex-direction: column; gap: 0.5rem; }
  @media (min-width: 768px) {
    .section-header { flex-direction: row; align-items: center; justify-content: space-between; }
  }
  .section-header__title { font-size: clamp(1.75rem, 1.05rem + 1.6vw, 2.25rem); line-height: 1.1; font-weight: 800; letter-spacing: -0.03em; color: #1d1d1f; }
  .section-header__desc {
    margin-top: 0.375rem; color: #6e6e73; font-size: 0.98rem; max-width: 60ch; line-height: 1.5;
  }
  .section-header__link {
    display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; color: #06c; transition: color .15s ease;
  }
  .section-header__link:hover { text-decoration: underline; }
  .section-header__link .chevron { font-size: 1.25em; line-height: 1; transform: translateY(-1px); }
</style>
