---
import '@styles/ribbon.css'
import { getCollection } from 'astro:content'
// 配置来源：src/content/ribbon/*.json（data collection，每个文件为数组）
// 每项：{ src: string; href?: string; ratio?: number | string, alt?: string }
// - ratio: 数字=相对上一张高度的比例；字符串=CSS 长度/百分比（仅 CSS 兜底）
// - 未设置 ratio：使用全局 --ribbon-overlap-ratio 或 --ribbon-overlap

const entries = await getCollection('ribbon')
const ribbonConfig = entries.flatMap((e: any) => e.data as any[])
---
<section class="ribbon-wall">
  <div class="ribbon-list" id="ribbonList">
    {ribbonConfig?.length ? (
      ribbonConfig.map((item, idx) => {
        const caption = (item as any).credit ?? (item as any).copyright ?? (item as any).alt;
        const content = (
          <>
            <img src={item.src} alt={item.alt ?? ''} class="ribbon-img" loading={idx > 2 ? 'lazy' : 'eager'} />
            {caption ? (
              <div class="ribbon-caption">{caption}</div>
            ) : null}
          </>
        )
        const style = typeof item.ratio === 'string' ? `--item-overlap: ${item.ratio}` : undefined
        const dataRatio = typeof item.ratio === 'number' ? String(item.ratio) : undefined
        return (
          <div class="ribbon-item" style={idx === 0 ? 'margin-top:0;' : style} data-overlap-ratio={dataRatio}>
            {item.href ? (
              <a href={item.href} class="ribbon-link" target="_blank" rel="noopener noreferrer">{content}</a>
            ) : content}
          </div>
        )
      })
    ) : (
      <div class="text-slate-500">暂无丝带配置。</div>
    )}
  </div>

  <script>
    // 基于上一张图片高度的重叠：ratio * prevHeight
    // 支持：
    // - 全局 CSS 变量 --ribbon-overlap-ratio（默认 0.1）
    // - 每项 item.ratio 为 number 时优先生效
    (function () {
      const root = document.getElementById('ribbonList');
      if (!root) return;
  const items = Array.from(root.querySelectorAll('.ribbon-item')) as HTMLElement[];
      if (!items.length) return;

      // 读取全局默认比例
      const getDefaultRatio = () => {
        const v = getComputedStyle(document.documentElement).getPropertyValue('--ribbon-overlap-ratio').trim();
        const num = parseFloat(v);
        return isNaN(num) ? 0.1 : num;
      };
      const getCaptionGap = () => {
        const v = getComputedStyle(document.documentElement).getPropertyValue('--ribbon-caption-gap').trim();
        const num = parseFloat(v);
        return isNaN(num) ? 20 : num;
      };

      const compute = () => {
        const defRatio = getDefaultRatio();
        for (let i = 0; i < items.length; i++) {
          const item = items[i];
          // CSS 兜底：如果已有 --item-overlap（字符串长度），则不覆盖
          const hasFixed = item.style.getPropertyValue('--item-overlap');
          if (i === 0) {
            item.style.marginTop = '0px';
            continue;
          }
          if (hasFixed) continue;

          const prev = items[i - 1];
          const prevImg = prev.querySelector('.ribbon-img') as HTMLImageElement | null;
          const ratioAttr = prevImg?.getAttribute('data-ratio');
          // 读取“配置 ratio 为 number”的通道：在 SSR 阶段无法直接，从 DOM 属性传递较复杂，这里采用 data 方案可扩展；
          // 当前实现：优先读 data-overlap-ratio（若存在），否则使用全局。
          let ratio = defRatio;
          const domRatio = item.getAttribute('data-overlap-ratio');
          if (domRatio) {
            const v = parseFloat(domRatio);
            if (!isNaN(v)) ratio = v;
          }

          const h = prev.getBoundingClientRect().height;
          const overlapPx = Math.max(0, Math.round(h * ratio));
          item.style.marginTop = `-${overlapPx}px`;
        }
      };

      // 初次计算：等待图片加载
  const imgs = Array.from(root.querySelectorAll('.ribbon-img')) as HTMLImageElement[];
      let pending = imgs.length;
      const done = () => { pending = Math.max(0, pending - 1); if (pending === 0) compute(); };
      imgs.forEach(img => {
        if (img.complete) return done();
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      });
      if (pending === 0) compute();

      // 窗口尺寸变化时重算
      let raf = 0;
      const onResize = () => {
        if (raf) cancelAnimationFrame(raf);
        raf = requestAnimationFrame(compute);
      };
      window.addEventListener('resize', onResize);
      const ro = new ResizeObserver(() => onResize());
      ro.observe(root);

      // 悬浮交互：不置顶，而是“上移上方、下移下方”以完整露出当前项
      function resetTransforms() {
        for (const el of items) el.style.transform = '';
      }

      function hoverAdjust(index: number) {
        resetTransforms();
        const defRatio = getDefaultRatio();
        const captionGap = getCaptionGap();

        // 仅计算并处理“下方让位”
        let downDelta = 0;
        if (index < items.length - 1) {
          const curr = items[index];
          const next = items[index + 1];
          const nextRatioStr = next.getAttribute('data-overlap-ratio');
          const nextRatio = nextRatioStr ? parseFloat(nextRatioStr) : defRatio;
          const currH = curr.getBoundingClientRect().height;
          downDelta = Math.max(0, Math.round(currH * (isNaN(nextRatio) ? defRatio : nextRatio)));
        }

        // 仅下方下移（上方不动）
        for (let i = 0; i < items.length; i++) {
          if (i > index) {
            const shift = downDelta + captionGap; // 让位 + 额外空白行
            if (shift) items[i].style.transform = `translateY(${shift}px)`;
          }
        }
      }

      items.forEach((el, idx) => {
        el.addEventListener('mouseenter', () => hoverAdjust(idx));
        el.addEventListener('mouseleave', () => resetTransforms());
      });
    })();
  </script>
</section>
