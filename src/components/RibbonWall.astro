---
import "@styles/ribbon.css";
import { getCollection } from "astro:content";
import { withBase } from "@utils/path";

const entries = await getCollection("ribbon");
const ribbonConfig = entries.flatMap((e: any) => e.data as any[]);
---

<section class="ribbon-wall">
    <div class="ribbon-list" id="ribbonList">
        {
            ribbonConfig?.length ? (
                ribbonConfig.map((item, idx) => {
                    const caption =
                        (item as any).credit ??
                        (item as any).copyright ??
                        (item as any).alt;
                    const content = (
                        <>
                            <img
                                src={withBase(item.src)}
                                alt={item.alt ?? ""}
                                class="ribbon-img"
                                loading={idx > 2 ? "lazy" : "eager"}
                            />
                            {caption ? (
                                <div class="ribbon-caption">{caption}</div>
                            ) : null}
                        </>
                    );
                    const style =
                        typeof item.ratio === "string"
                            ? `--item-overlap: ${item.ratio}`
                            : undefined;
                    const dataRatio =
                        typeof item.ratio === "number"
                            ? String(item.ratio)
                            : undefined;
                    return (
                        <div
                            class="ribbon-item"
                            style={idx === 0 ? "margin-top:0;" : style}
                            data-overlap-ratio={dataRatio}
                        >
                            {item.href ? (
                                <a
                                    href={item.href}
                                    class="ribbon-link"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {content}
                                </a>
                            ) : (
                                content
                            )}
                        </div>
                    );
                })
            ) : (
                <div class="text-slate-500">暂无丝带配置。</div>
            )
        }
    </div>

    <script>
        document.addEventListener('astro:page-load', () => {
            const root = document.getElementById("ribbonList");
            if (!root) return;
            const items = Array.from(
                root.querySelectorAll(".ribbon-item"),
            ) as HTMLElement[];
            if (!items.length) return;

            const getDefaultRatio = () => {
                const v = getComputedStyle(document.documentElement)
                    .getPropertyValue("--ribbon-overlap-ratio")
                    .trim();
                const num = parseFloat(v);
                return isNaN(num) ? 0.1 : num;
            };
            const getCaptionGap = () => {
                const v = getComputedStyle(document.documentElement)
                    .getPropertyValue("--ribbon-caption-gap")
                    .trim();
                const num = parseFloat(v);
                return isNaN(num) ? 20 : num;
            };

            const compute = () => {
                const defRatio = getDefaultRatio();
                for (let i = 0; i < items.length; i++) {
                    const item = items[i];
                    const hasFixed =
                        item.style.getPropertyValue("--item-overlap");
                    if (i === 0) {
                        item.style.marginTop = "0px";
                        continue;
                    }
                    if (hasFixed) continue;

                    const prev = items[i - 1];
                    let ratio = defRatio;
                    const domRatio = item.getAttribute("data-overlap-ratio");
                    if (domRatio) {
                        const v = parseFloat(domRatio);
                        if (!isNaN(v)) ratio = v;
                    }

                    const h = prev.getBoundingClientRect().height;
                    const overlapPx = Math.max(0, Math.round(h * ratio));
                    item.style.marginTop = `-${overlapPx}px`;
                }
            };

            const imgs = Array.from(
                root.querySelectorAll(".ribbon-img"),
            ) as HTMLImageElement[];
            let pending = imgs.length;
            const done = () => {
                pending = Math.max(0, pending - 1);
                if (pending === 0) compute();
            };
            imgs.forEach((img) => {
                if (img.complete) return done();
                img.addEventListener("load", done, { once: true });
                img.addEventListener("error", done, { once: true });
            });
            if (pending === 0) compute();

            let raf = 0;
            const onResize = () => {
                if (raf) cancelAnimationFrame(raf);
                raf = requestAnimationFrame(compute);
            };
            window.addEventListener("resize", onResize);
            const ro = new ResizeObserver(() => onResize());
            ro.observe(root);

            function resetTransforms() {
                for (const el of items) el.style.transform = "";
            }

            function hoverAdjust(index: number) {
                resetTransforms();
                const defRatio = getDefaultRatio();
                const captionGap = getCaptionGap();

                let downDelta = 0;
                if (index < items.length - 1) {
                    const curr = items[index];
                    const next = items[index + 1];
                    const nextRatioStr =
                        next.getAttribute("data-overlap-ratio");
                    const nextRatio = nextRatioStr
                        ? parseFloat(nextRatioStr)
                        : defRatio;
                    const currH = curr.getBoundingClientRect().height;
                    downDelta = Math.max(
                        0,
                        Math.round(
                            currH * (isNaN(nextRatio) ? defRatio : nextRatio),
                        ),
                    );
                }

                for (let i = 0; i < items.length; i++) {
                    if (i > index) {
                        const shift = downDelta + captionGap;
                        if (shift)
                            items[i].style.transform = `translateY(${shift}px)`;
                    }
                }
            }

            items.forEach((el, idx) => {
                el.addEventListener("mouseenter", () => hoverAdjust(idx));
                el.addEventListener("mouseleave", () => resetTransforms());
            });
        });
    </script>
</section>
