---
interface Props {
  title: string
  href: string
  summary: string
  icon?: string
}
const { title, href, summary, icon } = Astro.props as Props
import { withBase } from '@utils/path'
const resolvedHref = withBase(href)
const resolvedIcon = icon ? withBase(icon) : undefined
---
<a
  href={resolvedHref}
  class="dept-card group block w-full max-w-full rounded-2xl p-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
>
  <div class="relative z-10 flex items-start gap-4">
    <div class="dept-card-icon flex h-12 w-12 flex-none items-center justify-center overflow-hidden rounded-xl text-sky-600 dark:text-sky-400">
      {resolvedIcon ? (
        <img src={resolvedIcon} alt="" class="max-h-12 max-w-12 object-contain" loading="lazy" />
      ) : (
        <svg viewBox="0 0 24 24" width="28" height="28" class="text-sky-600 dark:text-sky-400"><path fill="currentColor" d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z"/></svg>
      )}
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="truncate text-base font-bold text-slate-800 dark:text-slate-100 group-hover:text-sky-600 dark:group-hover:text-sky-300 transition-colors">{title}</h3>
      <p class="mt-1 line-clamp-3 text-sm leading-6 text-slate-600 dark:text-slate-300 break-words">{summary}</p>
    </div>
  </div>
</a>
