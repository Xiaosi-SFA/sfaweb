---
interface Props {
  title: string
  href: string
  summary: string
  icon?: string
}
const { title, href, summary, icon } = Astro.props as Props
---
<a href={href} class="group block rounded-lg border border-slate-200 dark:border-[#2c2c2e] bg-white/90 dark:bg-[#2c2c2e]/60 p-4 shadow-sm transition hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400">
  <div class="flex items-start gap-4">
    <div class="flex h-12 w-12 flex-none items-center justify-center overflow-hidden rounded-md bg-slate-50 dark:bg-[#2c2c2e] ring-1 ring-slate-200 dark:ring-[#2c2c2e]">
      {icon ? (
        <img src={icon} alt="" class="max-h-12 max-w-12 object-contain" loading="lazy" />
      ) : (
        <svg viewBox="0 0 24 24" width="28" height="28" class="text-slate-400 dark:text-slate-500"><path fill="currentColor" d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z"/></svg>
      )}
    </div>
    <div class="min-w-0">
      <h3 class="truncate text-base font-semibold text-slate-800 dark:text-slate-200 group-hover:text-sky-700 dark:group-hover:text-sky-300">{title}</h3>
      <p class="mt-1 line-clamp-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{summary}</p>
    </div>
  </div>
</a>
